# Copy to .env and fill in real values. Never commit .env itself.
# Generate secrets with: openssl rand -hex 64  (SECRET_KEY)  /  openssl rand -hex 32 (POSTGRES_PASSWORD)

# --- Core ---
BASE_URL=https://planka.example.com
SECRET_KEY=changeme-generate-with-openssl-rand-hex-64

# --- Postgres ---
POSTGRES_PASSWORD=changeme-generate-with-openssl-rand-hex-32
DATABASE_URL=postgresql://postgres:changeme-generate-with-openssl-rand-hex-32@postgres/planka

