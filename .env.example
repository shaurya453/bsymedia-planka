# Copy to .env and fill in real values. Never commit .env itself.
# Generate secrets with: openssl rand -hex 64  (SECRET_KEY)  /  openssl rand -hex 32 (POSTGRES_PASSWORD)

# --- Core ---
BASE_URL=https://planka.example.com
SECRET_KEY=changeme-generate-with-openssl-rand-hex-64

# Max size for a single attachment upload. Unset = no app-level cap (falls
# through to whatever the upload library's own internals do, which is
# implicit and not something to rely on - confirmed 2026-08-09 that unset
# genuinely means uncapped here, not some small hidden default). Set
# explicitly so the real policy is visible in one place.
MAX_UPLOAD_FILE_SIZE=50MB

# --- Postgres ---
POSTGRES_PASSWORD=changeme-generate-with-openssl-rand-hex-32
DATABASE_URL=postgresql://postgres:changeme-generate-with-openssl-rand-hex-32@postgres/planka

# --- Bootstrap admin (first account; protected from edit/delete while set) ---
DEFAULT_ADMIN_EMAIL=admin@planka.local
DEFAULT_ADMIN_PASSWORD=changeme-generate-a-real-password
DEFAULT_ADMIN_NAME=PLANKA Admin
DEFAULT_ADMIN_USERNAME=admin

# --- Invite service (replaces the original OIDC/Google-Workspace SSO plan —
# BSY Media has no real Workspace, staff use personal Gmail only) ---
PUBLIC_URL=https://planka.example.com
PLANKA_PUBLIC_URL=https://planka.example.com
PLANKA_INTERNAL_URL=http://planka:1337
SESSION_SECRET=changeme-generate-with-openssl-rand-hex-32
OPS_DATABASE_URL=postgresql://postgres:changeme-generate-with-openssl-rand-hex-32@postgres/postgres

# Dedicated PLANKA admin account used only by invite-service's backend to
# create accounts when someone completes an invite (not a human login).
PLANKA_SERVICE_EMAIL=invite-service@planka.local
PLANKA_SERVICE_PASSWORD=changeme-generate-a-real-password

# Gmail SMTP - use an App Password (requires 2-Step Verification on the
# Google account), not the account's normal login password.
GMAIL_USER=changeme@gmail.com
GMAIL_APP_PASSWORD=changeme-16-char-app-password
