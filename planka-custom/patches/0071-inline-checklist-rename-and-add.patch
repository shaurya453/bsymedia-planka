+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+:global(#app) {
+  .controls {
+    clear: both;
+    margin-top: 6px;
+  }
+
+  // BSY Media: styles the nested <input> itself, not the .field wrapper div -
+  // the wrapper is Semantic UI's own ".ui.fluid.input" element, which relies
+  // on its own display: flex to make the inner input stretch to 100% width;
+  // styling the wrapper directly (as an earlier version of this file did,
+  // e.g. with display: block) clobbers that and collapses the input back to
+  // its tiny browser-default width. See custom-fields/CustomField/
+  // ValueField.module.scss's ".field input" for the same working pattern.
+  .field input {
+    background: #fff;
+    border: 1px solid rgba(9, 30, 66, 0.13);
+    border-radius: 3px;
+    color: #17394d;
+    font-size: 16px;
+    font-weight: bold;
+    padding: 6px 8px;
+
+    &:focus {
+      outline: none;
+    }
+  }
+
+  // BSY Media: fills the same flex slot the plain .moduleHeaderTitle span
+  // occupied in Item.jsx (moduleHeader is display: flex, with padding-right
+  // already reserved for the actions overlay) - flex: 1 + min-width: 0 lets
+  // the field grow to fill it without pushing the reserved actions space.
+  .wrapper {
+    flex: 1;
+    min-width: 0;
+    padding: 6px 0;
+  }
+}
