+    const board = yield select(selectors.selectBoardById, boardIds[i]);
+
+    try {
+      const exportedBoard = yield call(request, api.exportBoard, board.id);
+      downloadJsonFile(exportedBoard, `${project.name} - ${board.name}.json`);
+    } catch {
+      hasFailure = true;
+    }
+
+    if (i < boardIds.length - 1) {
+      yield delay(EXPORT_DOWNLOAD_DELAY);
+    }
+  }
+
+  if (hasFailure) {
+    yield call(toast, {
+      type: ToastTypes.PROJECT_EXPORT_PARTIALLY_FAILED,
+    });
