diff --git a/client/src/components/cards/CardModal/TaskLists/SelectStatusStep.jsx b/client/src/components/cards/CardModal/TaskLists/SelectStatusStep.jsx
new file mode 100644
index 0000000..d2d6406
--- /dev/null
+++ b/client/src/components/cards/CardModal/TaskLists/SelectStatusStep.jsx
@@ -0,0 +1,83 @@
+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+import React, { useCallback } from 'react';
+import PropTypes from 'prop-types';
+import classNames from 'classnames';
+import { Button } from 'semantic-ui-react';
+import { useTranslation } from 'react-i18next';
+import { Popup } from '../../../../lib/custom-ui';
+
+import { TaskListStatuses } from '../../../../constants/Enums';
+import TaskListStatusColors from '../../../../constants/TaskListStatusColors';
+
+import styles from './SelectStatusStep.module.scss';
+
+// BSY Media: manual checklist status toggle - a small fixed 3-option picker,
+// mirrors GanttModal/GanttChart/ColorPickerStep.jsx's Popup.Header/Content +
+// clear-button shape, but a labeled row list rather than a color swatch
+// grid, since the 3 options are text states, not colors.
+const SelectStatusStep = React.memo(({ status, onSelect, onClear, onClose }) => {
+  const [t] = useTranslation();
+
+  const handleSelectClick = useCallback(
+    (_, { value }) => {
+      onSelect(value);
+      onClose();
+    },
+    [onSelect, onClose],
+  );
+
+  const handleClearClick = useCallback(() => {
+    onClear();
+    onClose();
+  }, [onClear, onClose]);
+
+  return (
+    <>
+      <Popup.Header>{t('common.taskListStatus', { context: 'title' })}</Popup.Header>
+      <Popup.Content>
+        <div className={styles.options}>
+          {Object.values(TaskListStatuses).map((value) => (
+            <Button
+              key={value}
+              type="button"
+              value={value}
+              className={classNames(styles.option, value === status && styles.optionActive)}
+              onClick={handleSelectClick}
+            >
+              <span
+                className={styles.dot}
+                style={{ background: TaskListStatusColors[value] }}
+              />
+              {t(`common.taskListStatus_${value}`)}
+            </Button>
+          ))}
+        </div>
+        {status && (
+          <Button
+            fluid
+            content={t('action.removeStatus')}
+            className={styles.clearButton}
+            onClick={handleClearClick}
+          />
+        )}
+      </Popup.Content>
+    </>
+  );
+});
+
+SelectStatusStep.propTypes = {
+  status: PropTypes.string,
+  onSelect: PropTypes.func.isRequired,
+  onClear: PropTypes.func.isRequired,
+  onClose: PropTypes.func.isRequired,
+};
+
+SelectStatusStep.defaultProps = {
+  status: null,
+};
+
+export default SelectStatusStep;
