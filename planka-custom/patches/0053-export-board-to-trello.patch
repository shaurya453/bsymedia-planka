diff --git a/server/api/controllers/boards/export.js b/server/api/controllers/boards/export.js
new file mode 100644
index 0000000..51e76ef
--- /dev/null
+++ b/server/api/controllers/boards/export.js
@@ -0,0 +1,107 @@
+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+/**
+ * @swagger
+ * /boards/{id}/export:
+ *   get:
+ *     summary: Export board
+ *     description: Exports a board as a Trello-compatible JSON file, importable here or into Trello/other Trello-compatible apps.
+ *     tags:
+ *       - Boards
+ *     operationId: exportBoard
+ *     parameters:
+ *       - name: id
+ *         in: path
+ *         required: true
+ *         description: ID of the board to export
+ *         schema:
+ *           type: string
+ *           example: "1357158568008091264"
+ *       - name: type
+ *         in: query
+ *         required: true
+ *         description: Export format
+ *         schema:
+ *           type: string
+ *           enum: [trello]
+ *           example: trello
+ *     responses:
+ *       200:
+ *         description: Board exported successfully
+ *         content:
+ *           application/json:
+ *             schema:
+ *               type: object
+ *       400:
+ *         $ref: '#/components/responses/ValidationError'
+ *       401:
+ *         $ref: '#/components/responses/Unauthorized'
+ *       404:
+ *         $ref: '#/components/responses/NotFound'
+ */
+
+const { idInput } = require('../../../utils/inputs');
+
+const Errors = {
+  BOARD_NOT_FOUND: {
+    boardNotFound: 'Board not found',
+  },
+};
+
+module.exports = {
+  inputs: {
+    id: {
+      ...idInput,
+      required: true,
+    },
+    type: {
+      type: 'string',
+      isIn: Object.values(Board.ExportTypes),
+      required: true,
+    },
+  },
+
+  exits: {
+    boardNotFound: {
+      responseType: 'notFound',
+    },
+  },
+
+  async fn(inputs, exits) {
+    const { currentUser } = this.req;
+
+    const { board, project } = await sails.helpers.boards
+      .getPathToProjectById(inputs.id)
+      .intercept('pathNotFound', () => Errors.BOARD_NOT_FOUND);
+
+    if (currentUser.role !== User.Roles.ADMIN || project.ownerProjectManagerId) {
+      const isProjectManager = await sails.helpers.users.isProjectManager(
+        currentUser.id,
+        project.id,
+      );
+
+      if (!isProjectManager) {
+        const boardMembership = await BoardMembership.qm.getOneByBoardIdAndUserId(
+          board.id,
+          currentUser.id,
+        );
+
+        if (!boardMembership) {
+          throw Errors.BOARD_NOT_FOUND; // Forbidden
+        }
+      }
+    }
+
+    const exportedBoard = await sails.helpers.boards.exportToTrello(board);
+
+    this.res.set(
+      'Content-Disposition',
+      `attachment; filename="${board.name.replace(/[^\w\-. ]/g, '_')}.json"`,
+    );
+
+    return exits.success(exportedBoard);
+  },
+};
diff --git a/server/api/helpers/boards/export-to-trello.js b/server/api/helpers/boards/export-to-trello.js
new file mode 100644
index 0000000..35ebac0
--- /dev/null
+++ b/server/api/helpers/boards/export-to-trello.js
@@ -0,0 +1,160 @@
+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+// BSY Media: reverse of import-from-trello.js - produces a board.json shaped
+// like a real Trello export, so it can be re-imported here (via the existing
+// "From Trello" import) or dropped into Trello/any other Trello-compatible
+// kanban app. Only the fields the importer itself understands are emitted;
+// anything PLANKA-only (custom fields, card assignees, attachments, task
+// due dates) has no Trello equivalent and is intentionally left out.
+const TRELLO_COLOR_BY_PLANKA_COLOR = {
+  'muddy-grey': 'black',
+  'autumn-leafs': 'orange',
+  'morning-sky': 'sky',
+  'antique-blue': 'blue',
+  'egg-yellow': 'yellow',
+  'desert-sand': 'yellow',
+  'dark-granite': 'black',
+  'fresh-salad': 'green',
+  'lagoon-blue': 'blue',
+  'midnight-blue': 'blue',
+  'light-orange': 'orange',
+  'pumpkin-orange': 'orange',
+  'light-concrete': 'black',
+  'sunny-grass': 'green',
+  'navy-blue': 'blue',
+  'lilac-eyes': 'purple',
+  'apricot-red': 'red',
+  'orange-peel': 'orange',
+  'silver-glint': 'black',
+  'bright-moss': 'green',
+  'deep-ocean': 'blue',
+  'summer-sky': 'sky',
+  'berry-red': 'red',
+  'light-cocoa': 'orange',
+  'grey-stone': 'black',
+  'tank-green': 'green',
+  'coral-green': 'green',
+  'sugar-plum': 'purple',
+  'pink-tulip': 'pink',
+  'shady-rust': 'orange',
+  'wet-rock': 'black',
+  'wet-moss': 'lime',
+  'turquoise-sea': 'sky',
+  'lavender-fields': 'purple',
+  'piggy-red': 'red',
+  'light-mud': 'orange',
+  'gun-metal': 'black',
+  'modern-green': 'green',
+  'french-coast': 'blue',
+  'sweet-lilac': 'purple',
+  'red-burgundy': 'red',
+  'pirate-gold': 'yellow',
+};
+
+module.exports = {
+  inputs: {
+    board: {
+      type: 'ref',
+      required: true,
+    },
+  },
+
+  async fn(inputs) {
+    const { board } = inputs;
+
+    const labels = await Label.qm.getByBoardId(board.id);
+    const lists = await List.qm.getByBoardId(board.id);
+    const finiteLists = lists.filter((list) => sails.helpers.lists.isFinite(list));
+    const finiteListIds = sails.helpers.utils.mapRecords(finiteLists);
+
+    const cards = await Card.qm.getByListIds(finiteListIds);
+    const cardIds = sails.helpers.utils.mapRecords(cards);
+
+    const taskLists = await TaskList.qm.getByCardIds(cardIds);
+    const taskListIds = sails.helpers.utils.mapRecords(taskLists);
+
+    const tasks = await Task.qm.getByTaskListIds(taskListIds);
+    const cardLabels = await CardLabel.qm.getByCardIds(cardIds);
+
+    const comments = cardIds.length > 0 ? await Comment.find({ cardId: cardIds }).sort('id ASC') : [];
+    const userIds = _.uniq(comments.map((comment) => comment.userId));
+    const users = await User.qm.getByIds(userIds);
+    const userById = _.keyBy(users, 'id');
+
+    const trelloLabels = labels.map((label) => ({
+      id: label.id,
+      name: label.name || '',
+      color: TRELLO_COLOR_BY_PLANKA_COLOR[label.color] || null,
+    }));
+
+    const trelloLists = finiteLists.map((list) => ({
+      id: list.id,
+      name: list.name,
+      pos: list.position,
+      closed: false,
+    }));
+
+    const cardLabelIdsByCardId = _.groupBy(cardLabels, 'cardId');
+
+    const trelloCards = cards.map((card) => ({
+      id: card.id,
+      idList: card.listId,
+      name: card.name,
+      desc: card.description || '',
+      pos: card.position,
+      closed: false,
+      idLabels: (cardLabelIdsByCardId[card.id] || []).map((cardLabel) => cardLabel.labelId),
+    }));
+
+    const tasksByTaskListId = _.groupBy(tasks, 'taskListId');
+
+    const trelloChecklists = taskLists.map((taskList) => ({
+      id: taskList.id,
+      idCard: taskList.cardId,
+      name: taskList.name,
+      pos: taskList.position,
+      checkItems: (tasksByTaskListId[taskList.id] || []).map((task) => ({
+        id: task.id,
+        name: task.name,
+        pos: task.position,
+        state: task.isCompleted ? 'complete' : 'incomplete',
+      })),
+    }));
+
+    const trelloCommentActions = comments
+      .slice()
+      .reverse()
+      .map((comment) => {
+        const user = userById[comment.userId];
+
+        return {
+          id: comment.id,
+          type: 'commentCard',
+          date: comment.createdAt,
+          data: {
+            text: comment.text,
+            card: {
+              id: comment.cardId,
+            },
+          },
+          memberCreator: {
+            fullName: user ? user.name : 'Unknown user',
+            username: user ? user.username : 'unknown',
+          },
+        };
+      });
+
+    return {
+      id: board.id,
+      name: board.name,
+      labels: trelloLabels,
+      lists: trelloLists,
+      cards: trelloCards,
+      checklists: trelloChecklists,
+      actions: trelloCommentActions,
+    };
+  },
+};
