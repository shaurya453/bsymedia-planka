diff --git a/server/api/controllers/lists/archive.js b/server/api/controllers/lists/archive.js
new file mode 100644
index 0000000..88024ce
--- /dev/null
+++ b/server/api/controllers/lists/archive.js
@@ -0,0 +1,120 @@
+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+/**
+ * @swagger
+ * /lists/{id}/archive:
+ *   post:
+ *     summary: Archive list
+ *     description: Hides a list from the board without deleting it or its cards. Can only archive finite (active/closed) lists. Requires board editor permissions.
+ *     tags:
+ *       - Lists
+ *     operationId: archiveList
+ *     parameters:
+ *       - name: id
+ *         in: path
+ *         required: true
+ *         description: ID of the list to archive
+ *         schema:
+ *           type: string
+ *           example: "1357158568008091264"
+ *     responses:
+ *       200:
+ *         description: List archived successfully
+ *         content:
+ *           application/json:
+ *             schema:
+ *               type: object
+ *               required:
+ *                 - item
+ *               properties:
+ *                 item:
+ *                   $ref: '#/components/schemas/List'
+ *       400:
+ *         $ref: '#/components/responses/ValidationError'
+ *       401:
+ *         $ref: '#/components/responses/Unauthorized'
+ *       403:
+ *         $ref: '#/components/responses/Forbidden'
+ *       404:
+ *         $ref: '#/components/responses/NotFound'
+ */
+
+const { idInput } = require('../../../utils/inputs');
+
+const Errors = {
+  NOT_ENOUGH_RIGHTS: {
+    notEnoughRights: 'Not enough rights',
+  },
+  LIST_NOT_FOUND: {
+    listNotFound: 'List not found',
+  },
+};
+
+module.exports = {
+  inputs: {
+    id: {
+      ...idInput,
+      required: true,
+    },
+  },
+
+  exits: {
+    notEnoughRights: {
+      responseType: 'forbidden',
+    },
+    listNotFound: {
+      responseType: 'notFound',
+    },
+  },
+
+  async fn(inputs) {
+    const { currentUser } = this.req;
+
+    const pathToProject = await sails.helpers.lists
+      .getPathToProjectById(inputs.id)
+      .intercept('pathNotFound', () => Errors.LIST_NOT_FOUND);
+
+    const { list } = pathToProject;
+    const { board, project } = pathToProject;
+
+    const isBoardEditor = await sails.helpers.users.isBoardEditor(currentUser.id, board.id);
+
+    if (!isBoardEditor) {
+      const boardMembership = await BoardMembership.qm.getOneByBoardIdAndUserId(
+        board.id,
+        currentUser.id,
+      );
+
+      throw boardMembership ? Errors.NOT_ENOUGH_RIGHTS : Errors.LIST_NOT_FOUND;
+    }
+
+    if (!sails.helpers.lists.isKanban(list)) {
+      throw Errors.NOT_ENOUGH_RIGHTS;
+    }
+
+    // Idempotency guard - a double-click or race with another archive
+    // request should be a harmless not-found, not a crash.
+    if (list.archivedAt) {
+      throw Errors.LIST_NOT_FOUND;
+    }
+
+    const archivedList = await sails.helpers.lists.archiveOne.with({
+      project,
+      board,
+      record: list,
+      actorUser: currentUser,
+      request: this.req,
+    });
+
+    if (!archivedList) {
+      throw Errors.LIST_NOT_FOUND;
+    }
+
+    return {
+      item: archivedList,
+    };
+  },
+};
