+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+/**
+ * @swagger
+ * /lists/{id}/restore:
+ *   post:
+ *     summary: Restore list
+ *     description: Restores a previously archived list, appending it to the end of the board's list ordering. Requires board editor permissions.
+ *     tags:
+ *       - Lists
+ *     operationId: restoreList
+ *     parameters:
+ *       - name: id
+ *         in: path
+ *         required: true
+ *         description: ID of the list to restore
+ *         schema:
+ *           type: string
+ *           example: "1357158568008091264"
+ *     requestBody:
+ *       required: true
+ *       content:
+ *         application/json:
+ *           schema:
+ *             type: object
+ *             required:
+ *               - position
+ *             properties:
+ *               position:
+ *                 type: number
+ *                 minimum: 0
+ *                 description: Position of the list within the board once restored
+ *                 example: 65536
+ *     responses:
+ *       200:
+ *         description: List restored successfully
+ *         content:
+ *           application/json:
+ *             schema:
+ *               type: object
+ *               required:
+ *                 - item
+ *               properties:
+ *                 item:
+ *                   $ref: '#/components/schemas/List'
+ *       400:
+ *         $ref: '#/components/responses/ValidationError'
+ *       401:
+ *         $ref: '#/components/responses/Unauthorized'
+ *       403:
+ *         $ref: '#/components/responses/Forbidden'
+ *       404:
+ *         $ref: '#/components/responses/NotFound'
+ */
+
+const { idInput } = require('../../../utils/inputs');
+
+const Errors = {
+  NOT_ENOUGH_RIGHTS: {
+    notEnoughRights: 'Not enough rights',
+  },
+  LIST_NOT_FOUND: {
+    listNotFound: 'List not found',
+  },
+};
+
+module.exports = {
+  inputs: {
+    id: {
+      ...idInput,
+      required: true,
+    },
+    position: {
+      type: 'number',
+      min: 0,
+      required: true,
+    },
+  },
+
+  exits: {
+    notEnoughRights: {
+      responseType: 'forbidden',
+    },
+    listNotFound: {
+      responseType: 'notFound',
+    },
+  },
+
+  async fn(inputs) {
+    const { currentUser } = this.req;
+
+    const pathToProject = await sails.helpers.lists
+      .getPathToProjectById(inputs.id)
+      .intercept('pathNotFound', () => Errors.LIST_NOT_FOUND);
+
+    const { list } = pathToProject;
+    const { board, project } = pathToProject;
+
+    const isBoardEditor = await sails.helpers.users.isBoardEditor(currentUser.id, board.id);
+
+    if (!isBoardEditor) {
+      const boardMembership = await BoardMembership.qm.getOneByBoardIdAndUserId(
+        board.id,
+        currentUser.id,
+      );
+
+      throw boardMembership ? Errors.NOT_ENOUGH_RIGHTS : Errors.LIST_NOT_FOUND;
+    }
+
+    if (!sails.helpers.lists.isKanban(list)) {
+      throw Errors.NOT_ENOUGH_RIGHTS;
+    }
+
+    // Idempotency guard - mirrors archive.js.
+    if (!list.archivedAt) {
+      throw Errors.LIST_NOT_FOUND;
+    }
+
+    const restoredList = await sails.helpers.lists.restoreOne.with({
+      project,
+      board,
+      record: list,
+      position: inputs.position,
+      actorUser: currentUser,
+      request: this.req,
+    });
+
+    if (!restoredList) {
+      throw Errors.LIST_NOT_FOUND;
+    }
+
+    return {
+      item: restoredList,
+    };
+  },
+};
