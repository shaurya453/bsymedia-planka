@@ -0,0 +1,62 @@
+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+module.exports = {
+  inputs: {
+    record: {
+      type: 'ref',
+      required: true,
+    },
+    project: {
+      type: 'ref',
+      required: true,
+    },
+    board: {
+      type: 'ref',
+      required: true,
+    },
+    actorUser: {
+      type: 'ref',
+      required: true,
+    },
+    request: {
+      type: 'ref',
+    },
+  },
+
+  async fn(inputs) {
+    const { list } = await List.qm.updateOne(inputs.record.id, {
+      archivedAt: new Date().toISOString(),
+    });
+
+    if (list) {
+      sails.sockets.broadcast(
+        `board:${list.boardId}`,
+        'listUpdate',
+        {
+          item: list,
+        },
+        inputs.request,
+      );
+
+      const webhooks = await Webhook.qm.getAll();
+
+      sails.helpers.utils.sendWebhooks.with({
+        webhooks,
+        event: Webhook.Events.LIST_ARCHIVE,
+        buildData: () => ({
+          item: list,
+          included: {
+            projects: [inputs.project],
+            boards: [inputs.board],
+          },
+        }),
+        user: inputs.actorUser,
+      });
+    }
+
+    return list;
+  },
+};
diff --git a/server/api/helpers/lists/restore-one.js b/server/api/helpers/lists/restore-one.js
new file mode 100644
index 0000000..9e22278
--- /dev/null
+++ b/server/api/helpers/lists/restore-one.js
@@ -0,0 +1,99 @@
+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+module.exports = {
+  inputs: {
+    record: {
+      type: 'ref',
+      required: true,
+    },
+    position: {
+      type: 'number',
+      required: true,
+    },
+    project: {
+      type: 'ref',
+      required: true,
+    },
+    board: {
+      type: 'ref',
+      required: true,
+    },
+    actorUser: {
+      type: 'ref',
+      required: true,
+    },
+    request: {
+      type: 'ref',
+    },
+  },
+
+  async fn(inputs) {
+    const lists = await sails.helpers.boards.getKanbanListsById(inputs.board.id, {
+      exceptListIdOrIds: inputs.record.id,
+    });
+
+    const { position, repositions } = sails.helpers.utils.insertToPositionables(
+      inputs.position,
+      lists,
+    );
+
+    if (repositions.length > 0) {
+      // eslint-disable-next-line no-restricted-syntax
+      for (const reposition of repositions) {
+        // eslint-disable-next-line no-await-in-loop
+        await List.qm.updateOne(
+          {
+            id: reposition.record.id,
+            boardId: reposition.record.boardId,
+          },
+          {
+            position: reposition.position,
+          },
+        );
+
+        sails.sockets.broadcast(`board:${inputs.board.id}`, 'listUpdate', {
+          item: {
+            id: reposition.record.id,
+            position: reposition.position,
+          },
+        });
+      }
+    }
+
+    const { list } = await List.qm.updateOne(inputs.record.id, {
+      position,
+      archivedAt: null,
+    });
+
+    if (list) {
+      sails.sockets.broadcast(
+        `board:${list.boardId}`,
+        'listUpdate',
+        {
+          item: list,
+        },
+        inputs.request,
+      );
+
+      const webhooks = await Webhook.qm.getAll();
+
+      sails.helpers.utils.sendWebhooks.with({
+        webhooks,
+        event: Webhook.Events.LIST_RESTORE,
+        buildData: () => ({
+          item: list,
+          included: {
+            projects: [inputs.project],
+            boards: [inputs.board],
+          },
+        }),
+        user: inputs.actorUser,
+      });
+    }
+
+    return list;
+  },
+};
