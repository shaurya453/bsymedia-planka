diff --git a/server/db/migrations/20260819160000_add_submissions_total_to_card.js b/server/db/migrations/20260819160000_add_submissions_total_to_card.js
new file mode 100644
index 0000000..cf17850
--- /dev/null
+++ b/server/db/migrations/20260819160000_add_submissions_total_to_card.js
@@ -0,0 +1,36 @@
+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+module.exports.up = async (knex) => {
+  await knex.schema.alterTable('card', (table) => {
+    table.integer('submissions_total').notNullable().defaultTo(0);
+  });
+
+  // BSY Media: comments_total previously counted every comment row regardless
+  // of type (update + submission combined, a leftover from before the
+  // Submissions tab existed). Recompute it here to reflect update-type
+  // comments only, and backfill the new submissions_total from the same
+  // data, so cards with existing history get accurate split counters
+  // immediately rather than only cards touched going forward.
+  await knex.raw(`
+    UPDATE card
+    SET comments_total = COALESCE(counts.updates, 0),
+        submissions_total = COALESCE(counts.submissions, 0)
+    FROM (
+      SELECT
+        card_id,
+        COUNT(*) FILTER (WHERE type = 'update') AS updates,
+        COUNT(*) FILTER (WHERE type = 'submission') AS submissions
+      FROM comment
+      GROUP BY card_id
+    ) counts
+    WHERE card.id = counts.card_id
+  `);
+};
+
+module.exports.down = (knex) =>
+  knex.schema.alterTable('card', (table) => {
+    table.dropColumn('submissions_total');
+  });
