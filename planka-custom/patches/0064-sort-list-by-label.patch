+      case ListSortFieldNames.LABEL: {
+        // BSY Media: mirrors the grouping algorithm in the server's
+        // lists/sort-one helper - group cards by their dominant label
+        // (the one shared by the most cards on this list), largest group
+        // first, unlabeled cards last. Kept in sync with the server so the
+        // optimistic local reorder (before the request round-trips) matches
+        // what actually gets persisted.
+        const countByLabelId = {};
+        cardModels.forEach((cardModel) => {
+          cardModel.labels.toRefArray().forEach((label) => {
+            countByLabelId[label.id] = (countByLabelId[label.id] || 0) + 1;
