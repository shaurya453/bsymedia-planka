+                labelOrderById[labelId] < labelOrderById[dominantLabelId])
+            ) {
+              return labelId;
+            }
+
+            return dominantLabelId;
+          }, null);
+        });
+
+        cards.sort((card1, card2) => {
+          const labelId1 = dominantLabelIdByCardId[card1.id];
+          const labelId2 = dominantLabelIdByCardId[card2.id];
+          const count1 = labelId1 ? countByLabelId[labelId1] : 0;
+          const count2 = labelId2 ? countByLabelId[labelId2] : 0;
+
+          if (count1 !== count2) {
+            return count2 - count1;
+          }
+
+          const order1 = labelId1 ? labelOrderById[labelId1] : Infinity;
+          const order2 = labelId2 ? labelOrderById[labelId2] : Infinity;
+
+          if (order1 !== order2) {
+            return order1 - order2;
+          }
+
+          return card1.name.localeCompare(card2.name);
