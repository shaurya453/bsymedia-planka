+
+        const dominantLabelByCardId = {};
+        cardModels.forEach((cardModel) => {
+          dominantLabelByCardId[cardModel.id] = cardModel.labels
+            .toRefArray()
+            .reduce((dominantLabel, label) => {
+              if (
+                !dominantLabel ||
+                countByLabelId[label.id] > countByLabelId[dominantLabel.id] ||
+                (countByLabelId[label.id] === countByLabelId[dominantLabel.id] &&
+                  label.position < dominantLabel.position)
+              ) {
+                return label;
+              }
+
+              return dominantLabel;
+            }, null);
+        });
+
+        cardModels.sort((card1, card2) => {
+          const label1 = dominantLabelByCardId[card1.id];
+          const label2 = dominantLabelByCardId[card2.id];
+          const count1 = label1 ? countByLabelId[label1.id] : 0;
+          const count2 = label2 ? countByLabelId[label2.id] : 0;
+
+          if (count1 !== count2) {
+            return count2 - count1;
+          }
+
+          const position1 = label1 ? label1.position : Infinity;
+          const position2 = label2 ? label2.position : Infinity;
+
+          if (position1 !== position2) {
+            return position1 - position2;
+          }
+
+          return card1.name.localeCompare(card2.name);
+        });
+
+        break;
