+      // BSY Media: only rename/date changes are worth a card-activity entry -
+      // position (drag reorder) and the two display-preference toggles would
+      // just be noise. Compares the post-update record against the
+      // pre-update one (both DB-shaped) rather than the raw input values, so
+      // a same-value resubmit or a Date-vs-ISO-string type mismatch can't
+      // cause a false positive.
+      const isLoggableChange = ['name', 'startDate', 'dueDate', 'isDueCompleted'].some((key) => {
+        const prevValue = inputs.record[key];
+        const nextValue = taskList[key];
+
+        if (prevValue instanceof Date || nextValue instanceof Date) {
