+++ b/server/api/helpers/users/is-project-manager-or-admin.js
@@ -0,0 +1,38 @@
+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+// BSY Media: instance admins get the same project-manager-equivalent rights
+// as a real project manager, except on personally-owned projects. Mirrors
+// the identical bypass rule in is-board-editor.js.
+module.exports = {
+  inputs: {
+    id: {
+      type: 'string',
+      required: true,
+    },
+    projectId: {
+      type: 'string',
+      required: true,
+    },
+  },
+
+  async fn(inputs) {
+    const isProjectManager = await sails.helpers.users.isProjectManager(
+      inputs.id,
+      inputs.projectId,
+    );
+
+    if (isProjectManager) {
+      return true;
+    }
+
+    const [user, project] = await Promise.all([
+      User.qm.getOneById(inputs.id),
+      Project.qm.getOneById(inputs.projectId),
+    ]);
+
+    return user.role === User.Roles.ADMIN && !project.ownerProjectManagerId;
+  },
+};
