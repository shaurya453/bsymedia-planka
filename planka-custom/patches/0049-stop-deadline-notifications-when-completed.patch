+// BSY Media: a checklist ("main task") shouldn't keep pinging its deadline
+// once it no longer needs attention - either explicitly marked Completed
+// via its own status cycle, or implicitly done because every one of its
+// sub-tasks has already been checked off. Checked independently of
+// isDueCompleted (the separate manual "this specific due date is handled"
+// toggle, already covered by the query criteria below), so a checklist
+// without a completed status/tasks keeps behaving exactly as before. A
+// checklist with zero tasks is never considered done this way - there's
+// nothing to have completed.
+const isTaskListDeadlineActive = async (taskList) => {
+  if (taskList.status === TaskList.Statuses.COMPLETED) {
+    return false;
+  }
+
+  const tasks = await Task.qm.getByTaskListId(taskList.id);
+
+  return tasks.length === 0 || tasks.some((task) => !task.isCompleted);
+};
+
