new file mode 100644
index 0000000..a078328
--- /dev/null
+++ b/server/api/helpers/trash-expiry/process.js
@@ -0,0 +1,75 @@
+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+// BSY Media: called on a timer by the `trash-expiry` hook, not from an HTTP
+// request - permanently deletes any card that has been sitting in a Trash
+// system list for 30+ days. Reuses Card.listChangedAt (already refreshed to
+// "now" on every real listId change, see cards/update-one.js) as "when this
+// card entered Trash" - no new column/migration needed, and restoring a
+// card out of Trash naturally resets the clock for free, since that's also
+// a listId change.
+const EXPIRY_THRESHOLD_MS = 30 * 24 * 60 * 60 * 1000;
+
+module.exports = {
+  async fn() {
+    const adminUser = await User.qm.getOneByEmail(sails.config.custom.defaultAdminEmail || '');
+
+    if (!adminUser) {
+      sails.log.warn('trash-expiry: bootstrap admin user not found, skipping this run');
+      return;
+    }
+
+    const trashLists = await List.qm.getAllByType(List.Types.TRASH);
+
+    if (trashLists.length === 0) {
+      return;
+    }
+
+    const trashListIds = trashLists.map((list) => list.id);
+    const before = new Date(Date.now() - EXPIRY_THRESHOLD_MS);
+    const expiredCards = await Card.qm.getExpiredByListIds(trashListIds, before);
+
+    if (expiredCards.length === 0) {
+      return;
+    }
+
+    let deletedCount = 0;
+
+    // eslint-disable-next-line no-restricted-syntax
+    for (const card of expiredCards) {
+      try {
+        // eslint-disable-next-line no-await-in-loop
+        const pathToProject = await sails.helpers.cards
+          .getPathToProjectById(card.id)
+          .intercept('pathNotFound', () => null);
+
+        if (!pathToProject) {
+          continue; // eslint-disable-line no-continue
+        }
+
+        const { list, board, project } = pathToProject;
+
+        // eslint-disable-next-line no-await-in-loop
+        await sails.helpers.cards.deleteOne.with({
+          record: card,
+          project,
+          board,
+          list,
+          actorUser: adminUser,
+        });
+
+        deletedCount += 1;
+      } catch (error) {
+        sails.log.error(`trash-expiry: failed to delete expired card ${card.id}:`, error);
+      }
+    }
+
+    if (deletedCount > 0) {
+      sails.log.info(
+        `trash-expiry: permanently deleted ${deletedCount} card(s) from Trash (30+ days old)`,
+      );
+    }
+  },
+};
