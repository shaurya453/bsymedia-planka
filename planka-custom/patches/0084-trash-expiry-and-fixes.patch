new file mode 100644
index 0000000..63763af
--- /dev/null
+++ b/server/api/hooks/trash-expiry/index.js
@@ -0,0 +1,41 @@
+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+/**
+ * trash-expiry hook
+ *
+ * @description :: BSY Media - scans every board's Trash system list on a
+ *                 timer and permanently deletes any card that's been sitting
+ *                 there for 30+ days. Mirrors the `deadline-notifications`
+ *                 hook's setInterval pattern - this codebase has no cron/
+ *                 scheduling library, and none is added for this.
+ * @docs        :: https://sailsjs.com/docs/concepts/extending-sails/hooks
+ */
+
+module.exports = function defineTrashExpiryHook(sails) {
+  const CHECK_INTERVAL_MS = 60 * 60 * 1000;
+
+  const processTrashExpiry = async () => {
+    try {
+      await sails.helpers.trashExpiry.process();
+    } catch (error) {
+      sails.log.error('trash-expiry hook failed:', error);
+    }
+  };
+
+  return {
+    /**
+     * Runs when this Sails app loads/lifts.
+     */
+
+    async initialize() {
+      sails.log.info('Initializing custom hook (`trash-expiry`)');
+
+      setInterval(() => {
+        processTrashExpiry();
+      }, CHECK_INTERVAL_MS);
+    },
+  };
+};
