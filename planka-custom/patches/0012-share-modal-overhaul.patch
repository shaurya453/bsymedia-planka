@@ -0,0 +1,132 @@
+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+import React, { useCallback, useMemo } from 'react';
+import PropTypes from 'prop-types';
+import { useDispatch, useSelector } from 'react-redux';
+import { useTranslation } from 'react-i18next';
+import { Button, Dropdown, Icon } from 'semantic-ui-react';
+
+import selectors from '../../../../selectors';
+import entryActions from '../../../../entry-actions';
+import { usePopupInClosableContext } from '../../../../hooks';
+import { BoardMembershipRoles } from '../../../../constants/Enums';
+import UserAvatar from '../../../users/UserAvatar';
+import SelectPermissionsStep from '../../BoardMemberships/SelectPermissionsStep';
+import ConfirmationStep from '../../../common/ConfirmationStep';
+
+import styles from './Item.module.scss';
+
+const ROLE_OPTIONS = [BoardMembershipRoles.EDITOR, BoardMembershipRoles.VIEWER].map((role) => ({
+  value: role,
+  text: role,
+}));
+
+// BSY Media: inline role dropdown + remove, replacing the old 3-level
+// Group -> GroupItemsStep -> ActionsStep popup chain for the same action.
+const Item = React.memo(({ id }) => {
+  const selectBoardMembershipById = useMemo(() => selectors.makeSelectBoardMembershipById(), []);
+
+  const boardMembership = useSelector((state) => selectBoardMembershipById(state, id));
+
+  const user = useSelector((state) => {
+    const selectUserById = selectors.makeSelectUserById();
+    return selectUserById(state, boardMembership.userId);
+  });
+
+  const isCurrentUser = useSelector(
+    (state) => boardMembership.userId === selectors.selectCurrentUserId(state),
+  );
+
+  const canEdit = useSelector(selectors.selectIsCurrentUserManagerForCurrentProject);
+
+  const dispatch = useDispatch();
+  const [t] = useTranslation();
+
+  const handleRoleChange = useCallback(
+    (_, { value: role }) => {
+      if (role === boardMembership.role) {
+        return;
+      }
+
+      dispatch(
+        entryActions.updateBoardMembership(
+          id,
+          role === BoardMembershipRoles.EDITOR
+            ? { role }
+            : { role, canComment: !!boardMembership.canComment },
+        ),
+      );
+    },
+    [id, dispatch, boardMembership.role, boardMembership.canComment],
+  );
+
+  const handlePermissionsSelect = useCallback(
+    (data) => {
+      dispatch(entryActions.updateBoardMembership(id, data));
+    },
+    [id, dispatch],
+  );
+
+  const handleDeleteConfirm = useCallback(() => {
+    dispatch(entryActions.deleteBoardMembership(id));
+  }, [id, dispatch]);
+
+  const PermissionsPopup = usePopupInClosableContext(SelectPermissionsStep);
+  const DeletePopup = usePopupInClosableContext(ConfirmationStep);
+
+  return (
+    <div className={styles.wrapper}>
+      <span className={styles.user}>
+        <UserAvatar id={boardMembership.userId} />
+      </span>
+      <span className={styles.name}>{user.name}</span>
+      <Dropdown
+        basic
+        compact
+        selection
+        value={boardMembership.role}
+        options={ROLE_OPTIONS}
+        disabled={!canEdit}
+        className={styles.roleDropdown}
+        onChange={handleRoleChange}
+      />
+      {canEdit && (
+        <PermissionsPopup
+          boardMembership={boardMembership}
+          title="common.editPermissions"
+          buttonContent="action.save"
+          onSelect={handlePermissionsSelect}
+        >
+          <Button type="button" className={styles.iconButton} title={t('action.editPermissions')}>
+            <Icon fitted name="cog" />
+          </Button>
+        </PermissionsPopup>
+      )}
+      {(canEdit || isCurrentUser) && (
+        <DeletePopup
+          title={isCurrentUser ? 'common.leaveBoard' : 'common.removeMember'}
+          content={
+            isCurrentUser
+              ? 'common.areYouSureYouWantToLeaveBoard'
+              : 'common.areYouSureYouWantToRemoveThisMemberFromBoard'
+          }
+          buttonContent={isCurrentUser ? 'action.leaveBoard' : 'action.removeMember'}
+          onConfirm={handleDeleteConfirm}
+        >
+          <Button type="button" className={styles.iconButton}>
+            <Icon fitted name="trash alternate outline" />
+          </Button>
+        </DeletePopup>
+      )}
+    </div>
+  );
+});
+
+Item.propTypes = {
+  id: PropTypes.string.isRequired,
+};
+
+export default Item;
