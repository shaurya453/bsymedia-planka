+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+import React from 'react';
+import { useSelector } from 'react-redux';
+import { useTranslation } from 'react-i18next';
+import { Button, Divider, Header, Icon } from 'semantic-ui-react';
+
+import selectors from '../../../../selectors';
+import { usePopupInClosableContext } from '../../../../hooks';
+import { isUserAdminOrProjectOwner } from '../../../../utils/record-helpers';
+import AddStep from '../../BoardMemberships/AddStep';
+import Item from './Item';
+
+import styles from './MembersList.module.scss';
+
+// BSY Media: existing "pick an existing user" flow (AddStep) is reused
+// completely unmodified, hosted inside this open modal via
+// usePopupInClosableContext - see plan for why the wrapper isn't swapped.
+const MembersList = React.memo(() => {
+  const boardMembershipIds = useSelector((state) =>
+    selectors.selectMembershipsForCurrentBoard(state).map((boardMembership) => boardMembership.id),
+  );
+
+  const canAdd = useSelector((state) => {
+    const user = selectors.selectCurrentUser(state);
+
+    if (!isUserAdminOrProjectOwner(user)) {
+      return !selectors.selectCurrentUserMembershipForCurrentBoard(state);
+    }
+
+    return selectors.selectIsCurrentUserManagerForCurrentProject(state);
+  });
+
+  const [t] = useTranslation();
+
+  const AddPopup = usePopupInClosableContext(AddStep);
+
+  return (
+    <div className={styles.wrapper}>
+      <Divider horizontal className={styles.divider}>
+        <Header as="h4">{t('common.members', { context: 'title' })}</Header>
+      </Divider>
+      {boardMembershipIds.map((id) => (
+        <Item key={id} id={id} />
+      ))}
+      {canAdd && (
+        <AddPopup>
+          <Button type="button" basic className={styles.addButton}>
+            <Icon fitted name="add user" />
+            {t('action.addMember')}
+          </Button>
+        </AddPopup>
+      )}
+    </div>
+  );
+});
+
+export default MembersList;
