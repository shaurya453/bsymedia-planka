@@ -0,0 +1,133 @@
+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+import React, { useCallback, useState } from 'react';
+import { useSelector } from 'react-redux';
+import { useTranslation } from 'react-i18next';
+import { Button, Dropdown, Form, Input, Message } from 'semantic-ui-react';
+
+import selectors from '../../../../selectors';
+import { isUserAdminOrProjectOwner } from '../../../../utils/record-helpers';
+import { getAccessToken } from '../../../../utils/access-token-storage';
+import { BoardMembershipRoles } from '../../../../constants/Enums';
+
+import styles from './InviteByEmail.module.scss';
+
+const ROLE_OPTIONS = [BoardMembershipRoles.EDITOR, BoardMembershipRoles.VIEWER].map((role) => ({
+  value: role,
+  text: role,
+}));
+
+// BSY Media: lets a project manager/admin invite someone who doesn't have a
+// PLANKA account yet, without leaving the app - calls invite-service's own
+// JSON API (same-origin, Bearer-authenticated with this user's own PLANKA
+// access token) instead of the separate /invite/ webpage.
+const InviteByEmail = React.memo(() => {
+  const boardId = useSelector((state) => selectors.selectCurrentBoard(state).id);
+
+  const canInvite = useSelector((state) => {
+    const user = selectors.selectCurrentUser(state);
+
+    if (!isUserAdminOrProjectOwner(user)) {
+      return !selectors.selectCurrentUserMembershipForCurrentBoard(state);
+    }
+
+    return selectors.selectIsCurrentUserManagerForCurrentProject(state);
+  });
+
+  const [t] = useTranslation();
+
+  const [email, setEmail] = useState('');
+  const [boardRole, setBoardRole] = useState(BoardMembershipRoles.VIEWER);
+  const [status, setStatus] = useState(null); // null | 'submitting' | 'success' | { error }
+
+  const handleEmailChange = useCallback((event) => {
+    setEmail(event.target.value);
+    setStatus(null);
+  }, []);
+
+  const handleRoleChange = useCallback((_, { value }) => {
+    setBoardRole(value);
+  }, []);
+
+  const handleSubmit = useCallback(() => {
+    const cleanEmail = email.trim();
+
+    if (!cleanEmail) {
+      return;
+    }
+
+    setStatus('submitting');
+
+    fetch('/invite/api/send', {
+      method: 'POST',
+      headers: {
+        'Content-Type': 'application/json',
+        Authorization: `Bearer ${getAccessToken()}`,
+      },
+      body: JSON.stringify({
+        email: cleanEmail,
+        boardId,
+        boardRole,
+      }),
+    })
+      .then((response) => response.json().then((body) => ({ ok: response.ok, body })))
+      .then(({ ok, body }) => {
+        if (!ok) {
+          throw new Error(body.error || 'Could not send invite');
+        }
+
+        setEmail('');
+        setStatus('success');
+      })
+      .catch((error) => {
+        setStatus({
+          error: error.message,
+        });
+      });
+  }, [email, boardId, boardRole]);
+
+  if (!canInvite) {
+    return null;
+  }
+
+  return (
+    <div className={styles.wrapper}>
+      <Form onSubmit={handleSubmit}>
+        <Input
+          fluid
+          type="email"
+          value={email}
+          placeholder={t('common.email')}
+          maxLength={256}
+          className={styles.input}
+          action={
+            <Dropdown
+              button
+              basic
+              value={boardRole}
+              options={ROLE_OPTIONS}
+              className={styles.roleDropdown}
+              onChange={handleRoleChange}
+            />
+          }
+          onChange={handleEmailChange}
+        />
+        <Button
+          fluid
+          primary
+          content={t('action.sendInvite')}
+          loading={status === 'submitting'}
+          disabled={status === 'submitting' || !email.trim()}
+          className={styles.submitButton}
+        />
+      </Form>
+      {status === 'success' && <Message positive size="tiny" content={t('common.inviteSent')} />}
+      {status && status.error && <Message negative size="tiny" content={status.error} />}
+    </div>
+  );
+});
+
+export default InviteByEmail;
