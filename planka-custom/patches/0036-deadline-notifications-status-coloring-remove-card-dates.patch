+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+// BSY Media: called on a timer by the `deadline-notifications` hook, not
+// from an HTTP request - there's no real "actor" here, so the bootstrap
+// admin account (sails.config.custom.defaultAdminEmail) is used purely to
+// satisfy Notification.creatorUserId's schema requirement. The client-side
+// rendering for these 4 notification types deliberately never displays
+// this name/avatar (see NotificationsStep/Item.jsx) - the wording is
+// impersonal by design.
+const notifyAndMark = async (taskList, actionType, trackingField, adminUser, webhooks) => {
+  if (taskList.assigneeUserId === adminUser.id) {
+    return;
+  }
+
+  const assigneeUser = await User.qm.getOneById(taskList.assigneeUserId, {
+    withDeactivated: false,
+  });
+
+  if (!assigneeUser) {
+    return;
+  }
+
+  const pathToProject = await sails.helpers.taskLists
+    .getPathToProjectById(taskList.id)
+    .intercept('pathNotFound', () => null);
+
+  if (!pathToProject) {
+    return;
+  }
+
+  const { card, list, board, project } = pathToProject;
+
+  const isBoardMember = await sails.helpers.users.isBoardMember(assigneeUser.id, board.id);
+
+  if (!isBoardMember) {
+    return;
+  }
+
+  await sails.helpers.actions.createOne.with({
+    webhooks,
+    values: {
+      type: actionType,
+      data: {
+        user: { id: taskList.assigneeUserId },
+        card: _.pick(card, ['name']),
+        taskList: _.pick(taskList, ['id', 'name']),
+      },
+      user: adminUser,
+      card,
+    },
+    project,
+    board,
+    list,
+  });
+
+  await TaskList.qm.updateOne(taskList.id, {
+    [trackingField]: new Date().toISOString(),
+  });
+};
+
+module.exports = {
+  async fn() {
+    const adminUser = await User.qm.getOneByEmail(sails.config.custom.defaultAdminEmail || '');
+
+    if (!adminUser) {
+      sails.log.warn(
+        'deadline-notifications: bootstrap admin user not found, skipping this run',
+      );
+      return;
+    }
+
+    const webhooks = await Webhook.qm.getAll();
+    const now = new Date();
+    const dueSoonThreshold = new Date(now.getTime() + 24 * 60 * 60 * 1000);
+
+    const overdueTaskLists = await TaskList.qm.getOverdue(now);
+
+    // eslint-disable-next-line no-restricted-syntax
+    for (const taskList of overdueTaskLists) {
+      try {
+        // eslint-disable-next-line no-await-in-loop
+        await notifyAndMark(
+          taskList,
+          Action.Types.TASK_LIST_OVERDUE,
+          'lastOverdueNotifiedAt',
+          adminUser,
+          webhooks,
+        );
+      } catch (error) {
+        sails.log.error(`deadline-notifications: failed to notify overdue task list ${taskList.id}:`, error);
+      }
+    }
+
+    const dueSoonTaskLists = await TaskList.qm.getDueSoon(now, dueSoonThreshold);
+
+    // eslint-disable-next-line no-restricted-syntax
+    for (const taskList of dueSoonTaskLists) {
+      try {
+        // eslint-disable-next-line no-await-in-loop
+        await notifyAndMark(
+          taskList,
+          Action.Types.TASK_LIST_DUE_SOON,
+          'lastDueSoonNotifiedAt',
+          adminUser,
+          webhooks,
+        );
+      } catch (error) {
+        sails.log.error(`deadline-notifications: failed to notify due-soon task list ${taskList.id}:`, error);
+      }
+    }
+  },
+};
