@@ -0,0 +1,46 @@
+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+/**
+ * deadline-notifications hook
+ *
+ * @description :: BSY Media - scans TaskList/Task rows on a timer for
+ *                 dueDates crossing the "due soon" (<24h) or "overdue"
+ *                 threshold and notifies the assignee. Mirrors the
+ *                 `watcher` hook's setInterval pattern - this codebase has
+ *                 no cron/scheduling library, and none is added for this.
+ * @docs        :: https://sailsjs.com/docs/concepts/extending-sails/hooks
+ */
+
+module.exports = function defineDeadlineNotificationsHook(sails) {
+  const CHECK_INTERVAL_MS = 60 * 1000;
+
+  // Unlike watcher's synchronous callback, this one does async DB/network
+  // work - a bare setInterval callback can't reject into anything, so an
+  // unhandled promise rejection here would otherwise be silent/noisy on
+  // every tick if a query ever fails transiently. Log and keep running.
+  const processDeadlines = async () => {
+    try {
+      await sails.helpers.deadlineNotifications.processTaskLists();
+      await sails.helpers.deadlineNotifications.processTasks();
+    } catch (error) {
+      sails.log.error('deadline-notifications hook failed:', error);
+    }
+  };
+
+  return {
+    /**
+     * Runs when this Sails app loads/lifts.
+     */
+
+    async initialize() {
+      sails.log.info('Initializing custom hook (`deadline-notifications`)');
+
+      setInterval(() => {
+        processDeadlines();
+      }, CHECK_INTERVAL_MS);
+    },
+  };
+};
