diff --git a/client/src/utils/get-due-date-status.js b/client/src/utils/get-due-date-status.js
new file mode 100644
index 0000000..bd0b96d
--- /dev/null
+++ b/client/src/utils/get-due-date-status.js
@@ -0,0 +1,34 @@
+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+// BSY Media: shared 24-hour due-soon/overdue threshold logic, originally
+// local to DueDateChip.jsx - extracted so the card-face title-coloring
+// feature (Card/TaskList/TaskList.jsx, Card/TaskList/Task.jsx) can reuse
+// the exact same math instead of duplicating it a third place.
+export const DueDateStatuses = {
+  DUE_SOON: 'dueSoon',
+  OVERDUE: 'overdue',
+  COMPLETED: 'completed',
+};
+
+const getDueDateStatus = (date, isCompleted) => {
+  if (isCompleted) {
+    return DueDateStatuses.COMPLETED;
+  }
+
+  const secondsLeft = Math.floor((date.getTime() - new Date().getTime()) / 1000);
+
+  if (secondsLeft <= 0) {
+    return DueDateStatuses.OVERDUE;
+  }
+
+  if (secondsLeft <= 24 * 60 * 60) {
+    return DueDateStatuses.DUE_SOON;
+  }
+
+  return null;
+};
+
+export default getDueDateStatus;
