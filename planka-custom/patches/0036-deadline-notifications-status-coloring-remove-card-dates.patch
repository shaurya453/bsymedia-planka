@@ -0,0 +1,47 @@
+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+import { useEffect, useRef } from 'react';
+import { useForceUpdate } from '../lib/hooks';
+import getDueDateStatus, { DueDateStatuses } from '../utils/get-due-date-status';
+
+// BSY Media: live-updating due-soon/overdue/completed status for a given
+// date - extracted from DueDateChip.jsx's own polling logic so the
+// card-face title-coloring feature can share the exact same
+// live-update behavior (re-renders on the second the status actually
+// changes, stops polling once overdue/completed) instead of duplicating it.
+const useDueDateStatus = (date, isCompleted) => {
+  const forceUpdate = useForceUpdate();
+  const statusRef = useRef(date ? getDueDateStatus(date, isCompleted) : null);
+  statusRef.current = date ? getDueDateStatus(date, isCompleted) : null;
+
+  useEffect(() => {
+    if (
+      !date ||
+      statusRef.current === DueDateStatuses.OVERDUE ||
+      statusRef.current === DueDateStatuses.COMPLETED
+    ) {
+      return undefined;
+    }
+
+    const intervalId = setInterval(() => {
+      const status = getDueDateStatus(date, isCompleted);
+
+      if (status !== statusRef.current) {
+        forceUpdate();
+      }
+
+      if (status === DueDateStatuses.OVERDUE) {
+        clearInterval(intervalId);
+      }
+    }, 1000);
+
+    return () => clearInterval(intervalId);
+  }, [date, isCompleted, forceUpdate]);
+
+  return statusRef.current;
+};
+
+export default useDueDateStatus;
