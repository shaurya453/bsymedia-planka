diff --git a/client/src/components/boards/GanttModal/GanttChart/Row.jsx b/client/src/components/boards/GanttModal/GanttChart/Row.jsx
new file mode 100644
index 0000000..865abd3
--- /dev/null
+++ b/client/src/components/boards/GanttModal/GanttChart/Row.jsx
@@ -0,0 +1,115 @@
+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+import React, { useMemo } from 'react';
+import PropTypes from 'prop-types';
+import classNames from 'classnames';
+import differenceInCalendarDays from 'date-fns/differenceInCalendarDays';
+
+import { usePopupInClosableContext } from '../../../../hooks';
+import EditDueDateStep from '../../../cards/EditDueDateStep';
+
+import styles from './Row.module.scss';
+
+// BSY Media: one bar/label row of the Gantt chart. Bar geometry is computed
+// from the shared rangeStart + dayWidth passed down by GanttChart so every
+// row lines up under the same day-scale header. Clicking a bar reuses the
+// existing Dates popup (EditDueDateStep) unmodified - no drag/resize on the
+// chart itself, per the confirmed interaction model.
+const Row = React.memo(
+  ({
+    label,
+    isGroupHeader,
+    isGroupBoundary,
+    startDate,
+    dueDate,
+    cardId,
+    taskListId,
+    rangeStart,
+    dayWidth,
+    canEdit,
+  }) => {
+    const EditDatesPopup = usePopupInClosableContext(EditDueDateStep);
+
+    const bar = useMemo(() => {
+      if (!startDate && !dueDate) {
+        return null;
+      }
+
+      const anchorDate = startDate || dueDate;
+      const left = differenceInCalendarDays(anchorDate, rangeStart) * dayWidth;
+
+      if (startDate && dueDate) {
+        const width = (differenceInCalendarDays(dueDate, startDate) + 1) * dayWidth;
+
+        return {
+          left,
+          width: Math.max(width, dayWidth),
+          background: 'linear-gradient(90deg, #2185d0, #e8632c)',
+        };
+      }
+
+      return {
+        left,
+        width: dayWidth,
+        background: startDate ? '#2185d0' : '#e8632c',
+      };
+    }, [startDate, dueDate, rangeStart, dayWidth]);
+
+    const barStyle = bar && {
+      left: bar.left,
+      width: bar.width,
+      background: bar.background,
+    };
+
+    const isClickable = !!bar && canEdit && !!(cardId || taskListId);
+
+    return (
+      <div
+        className={classNames(
+          styles.row,
+          isGroupHeader && styles.rowGroupHeader,
+          isGroupBoundary && styles.rowGroupBoundary,
+        )}
+      >
+        <div className={classNames(styles.label, !isGroupHeader && styles.labelIndented)}>
+          {label}
+        </div>
+        <div className={styles.track}>
+          {bar &&
+            (isClickable ? (
+              <EditDatesPopup cardId={cardId} taskListId={taskListId}>
+                <button type="button" className={styles.barButton} style={barStyle} />
+              </EditDatesPopup>
+            ) : (
+              <div className={styles.bar} style={barStyle} />
+            ))}
+        </div>
+      </div>
+    );
+  },
+);
+
+Row.propTypes = {
+  label: PropTypes.node.isRequired,
+  isGroupHeader: PropTypes.bool.isRequired,
+  isGroupBoundary: PropTypes.bool.isRequired,
+  startDate: PropTypes.instanceOf(Date),
+  dueDate: PropTypes.instanceOf(Date),
+  cardId: PropTypes.string,
+  taskListId: PropTypes.string,
+  rangeStart: PropTypes.instanceOf(Date).isRequired,
+  dayWidth: PropTypes.number.isRequired,
+  canEdit: PropTypes.bool.isRequired,
+};
+
+Row.defaultProps = {
+  startDate: null,
+  dueDate: null,
+  cardId: undefined,
+  taskListId: undefined,
+};
+
+export default Row;
