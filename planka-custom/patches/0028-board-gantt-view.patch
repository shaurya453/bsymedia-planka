+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+import React from 'react';
+import PropTypes from 'prop-types';
+import { useSelector } from 'react-redux';
+import { useTranslation } from 'react-i18next';
+import { Icon, Progress } from 'semantic-ui-react';
+
+import selectors from '../../../../selectors';
+import { usePopupInClosableContext } from '../../../../hooks';
+import { BoardMembershipRoles } from '../../../../constants/Enums';
+import EditDueDateStep from '../../../cards/EditDueDateStep';
+import DueDateChip from '../../../cards/DueDateChip';
+
+import styles from './Tasks.module.scss';
+
+const ChecklistRow = React.memo(({ taskList, canEdit }) => {
+  const EditDatesPopup = usePopupInClosableContext(EditDueDateStep);
+  const [t] = useTranslation();
+
+  const hasDates = !!(taskList.startDate || taskList.dueDate);
+
+  const content = (
+    <div className={styles.checklistRow}>
+      <Icon name="check square outline" className={styles.checklistIcon} />
+      <span className={styles.checklistName}>{taskList.name}</span>
+      {taskList.tasksTotal > 0 && (
+        <span className={styles.progressWrapper}>
+          <Progress
+            autoSuccess
+            value={taskList.tasksCompletedCount}
+            total={taskList.tasksTotal}
+            color="blue"
+            size="tiny"
+            className={styles.progress}
+          />
+          <span className={styles.progressCount}>
+            {taskList.tasksCompletedCount}/{taskList.tasksTotal}
+          </span>
+        </span>
+      )}
+      {hasDates ? (
+        <span className={styles.dates}>
+          {taskList.startDate && (
+            <DueDateChip
+              size="tiny"
+              value={taskList.startDate}
+              isCompleted={false}
+              withStatus={false}
+            />
+          )}
+          {taskList.dueDate && (
+            <DueDateChip
+              size="tiny"
+              withStatusIcon
+              value={taskList.dueDate}
+              isCompleted={taskList.isDueCompleted}
+              withStatus
+            />
+          )}
+        </span>
+      ) : (
+        <span className={styles.noDate}>{t('common.noDateSet')}</span>
+      )}
+    </div>
+  );
+
+  if (!canEdit) {
+    return content;
+  }
+
+  return (
+    <EditDatesPopup taskListId={taskList.id}>
+      <button type="button" className={styles.rowButton}>
+        {content}
+      </button>
+    </EditDatesPopup>
+  );
+});
+
+ChecklistRow.propTypes = {
+  taskList: PropTypes.shape({
+    id: PropTypes.string.isRequired,
+    name: PropTypes.string.isRequired,
+    startDate: PropTypes.instanceOf(Date),
+    dueDate: PropTypes.instanceOf(Date),
+    isDueCompleted: PropTypes.bool.isRequired,
+    tasksTotal: PropTypes.number.isRequired,
+    tasksCompletedCount: PropTypes.number.isRequired,
+  }).isRequired,
+  canEdit: PropTypes.bool.isRequired,
+};
+
+const CardGroup = React.memo(({ item, canEdit }) => {
+  const EditDatesPopup = usePopupInClosableContext(EditDueDateStep);
+
+  const hasDates = !!(item.startDate || item.dueDate);
+
+  const header = (
+    <div className={styles.cardHeader}>
+      <span className={styles.cardName}>{item.cardName}</span>
+      {item.listName && (
+        <span className={styles.listBadge}>
+          <Icon name="columns" />
+          {item.listName}
+        </span>
+      )}
+      {hasDates && (
+        <span className={styles.dates}>
+          {item.startDate && (
+            <DueDateChip size="tiny" value={item.startDate} isCompleted={false} withStatus={false} />
+          )}
+          {item.dueDate && (
+            <DueDateChip
+              size="tiny"
+              withStatusIcon
+              value={item.dueDate}
+              isCompleted={item.isDueCompleted}
+              withStatus
+            />
+          )}
+        </span>
+      )}
+    </div>
+  );
+
+  return (
+    <div className={styles.card}>
+      {canEdit ? (
+        <EditDatesPopup cardId={item.cardId}>
+          <button type="button" className={styles.cardHeaderButton}>
+            {header}
+          </button>
+        </EditDatesPopup>
+      ) : (
+        header
+      )}
+      {item.taskLists.length > 0 && (
+        <div className={styles.checklists}>
+          {item.taskLists.map((taskList) => (
+            <ChecklistRow key={taskList.id} taskList={taskList} canEdit={canEdit} />
+          ))}
+        </div>
+      )}
+    </div>
+  );
+});
+
+CardGroup.propTypes = {
+  item: PropTypes.shape({
+    cardId: PropTypes.string.isRequired,
+    cardName: PropTypes.string.isRequired,
+    listName: PropTypes.string,
+    startDate: PropTypes.instanceOf(Date),
+    dueDate: PropTypes.instanceOf(Date),
+    isDueCompleted: PropTypes.bool.isRequired,
+    taskLists: PropTypes.array.isRequired, // eslint-disable-line react/forbid-prop-types
+  }).isRequired,
+  canEdit: PropTypes.bool.isRequired,
+};
+
+// BSY Media: full audit view - unlike Timeline/Schedule, lists every card
+// (and every checklist on it) regardless of whether dates are set, so it
+// doubles as "what checklists exist on this board at all".
+const Tasks = React.memo(() => {
+  const items = useSelector(selectors.selectGanttItemsForCurrentBoard);
+
+  const canEdit = useSelector((state) => {
+    const boardMembership = selectors.selectCurrentUserMembershipForCurrentBoard(state);
+    return !!boardMembership && boardMembership.role === BoardMembershipRoles.EDITOR;
+  });
+
+  const [t] = useTranslation();
+
+  if (items.length === 0) {
+    return <div className={styles.empty}>{t('common.noCardsOnThisBoardYet')}</div>;
+  }
+
+  return (
+    <div className={styles.wrapper}>
+      {items.map((item) => (
+        <CardGroup key={item.cardId} item={item} canEdit={canEdit} />
+      ))}
+    </div>
+  );
+});
+
+export default Tasks;
