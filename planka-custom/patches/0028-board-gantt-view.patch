@@ -0,0 +1,130 @@
+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+import React, { useMemo } from 'react';
+import { useSelector } from 'react-redux';
+import { useTranslation } from 'react-i18next';
+import { Icon } from 'semantic-ui-react';
+
+import selectors from '../../../../selectors';
+import { BoardMembershipRoles } from '../../../../constants/Enums';
+import UserAvatar from '../../../users/UserAvatar';
+import GanttChart from '../GanttChart';
+
+import styles from './TeamWorkload.module.scss';
+
+// BSY Media: same GanttChart renderer as Timeline, grouped by board member
+// instead of by card - each member's dated cards and dated checklists are
+// nested under their name. Attribution is card-membership only (checklist
+// items do have an assigneeUserId field, but no dates to plot, so they're
+// intentionally not used here).
+const TeamWorkload = React.memo(() => {
+  const items = useSelector(selectors.selectGanttItemsForCurrentBoard);
+  const memberships = useSelector(selectors.selectMembershipsForCurrentBoard);
+
+  const canEdit = useSelector((state) => {
+    const boardMembership = selectors.selectCurrentUserMembershipForCurrentBoard(state);
+    return !!boardMembership && boardMembership.role === BoardMembershipRoles.EDITOR;
+  });
+
+  const [t] = useTranslation();
+
+  const rows = useMemo(() => {
+    const result = [];
+
+    memberships.forEach((membership) => {
+      const { userId } = membership;
+
+      result.push({
+        key: `member:${userId}`,
+        label: (
+          <span className={styles.member}>
+            <UserAvatar id={userId} size="tiny" />
+            <span className={styles.memberName}>{membership.user.name}</span>
+          </span>
+        ),
+        isGroupHeader: true,
+        isGroupBoundary: result.length > 0,
+        startDate: null,
+        dueDate: null,
+      });
+
+      let memberRowsTotal = 0;
+
+      items
+        .filter((item) => item.userIds.includes(userId))
+        .forEach((item) => {
+          const datedTaskLists = item.taskLists.filter(
+            (taskList) => taskList.startDate || taskList.dueDate,
+          );
+
+          const cardHasDates = !!(item.startDate || item.dueDate);
+
+          if (!cardHasDates && datedTaskLists.length === 0) {
+            return;
+          }
+
+          result.push({
+            key: `${userId}:card:${item.cardId}`,
+            label: (
+              <span className={styles.itemLabel}>
+                <Icon name="file outline" className={styles.itemIcon} />
+                {item.cardName}
+              </span>
+            ),
+            isGroupHeader: false,
+            isGroupBoundary: false,
+            startDate: item.startDate,
+            dueDate: item.dueDate,
+            cardId: item.cardId,
+          });
+          memberRowsTotal += 1;
+
+          datedTaskLists.forEach((taskList) => {
+            result.push({
+              key: `${userId}:taskList:${taskList.id}`,
+              label: (
+                <span className={styles.itemLabelChecklist}>
+                  <Icon name="check square outline" className={styles.itemIcon} />
+                  {taskList.name}
+                </span>
+              ),
+              isGroupHeader: false,
+              isGroupBoundary: false,
+              startDate: taskList.startDate,
+              dueDate: taskList.dueDate,
+              taskListId: taskList.id,
+            });
+            memberRowsTotal += 1;
+          });
+        });
+
+      if (memberRowsTotal === 0) {
+        result.push({
+          key: `${userId}:empty`,
+          label: <span className={styles.emptyLabel}>{t('common.noScheduledItems')}</span>,
+          isGroupHeader: false,
+          isGroupBoundary: false,
+          startDate: null,
+          dueDate: null,
+        });
+      }
+    });
+
+    return result;
+  }, [items, memberships, t]);
+
+  return (
+    <div className={styles.wrapper}>
+      <GanttChart
+        rows={rows}
+        canEdit={canEdit}
+        emptyMessage={t('common.noDatedCardsOrChecklistsYet')}
+      />
+    </div>
+  );
+});
+
+export default TeamWorkload;
