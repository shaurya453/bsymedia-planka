diff --git a/client/src/selectors/gantt.js b/client/src/selectors/gantt.js
new file mode 100644
index 0000000..2c7826c
--- /dev/null
+++ b/client/src/selectors/gantt.js
@@ -0,0 +1,74 @@
+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+import { createSelector } from 'redux-orm';
+
+import orm from '../orm';
+import { selectPath } from './router';
+
+const toDateOrNull = (value) => {
+  if (!value) {
+    return null;
+  }
+
+  return value instanceof Date ? value : new Date(value);
+};
+
+// BSY Media: single source of truth for the board Gantt view (Timeline /
+// Tasks / Team workload / Schedule tabs) - walks every active card on the
+// board once and normalizes card + checklist dates into Date instances
+// (Card dates are already Date objects via the API transform layer,
+// TaskList dates are raw ISO strings - see EditDueDateStep.jsx) so none of
+// the 4 tab components need to care which model they came from.
+export const selectGanttItemsForCurrentBoard = createSelector(
+  orm,
+  (state) => selectPath(state).boardId,
+  ({ Board }, id) => {
+    if (!id) {
+      return [];
+    }
+
+    const boardModel = Board.withId(id);
+
+    if (!boardModel) {
+      return [];
+    }
+
+    return boardModel.getCardsModelArray().map((cardModel) => {
+      const taskLists = cardModel
+        .getTaskListsQuerySet()
+        .toModelArray()
+        .map((taskListModel) => {
+          const taskRefs = taskListModel.getTasksQuerySet().toRefArray();
+
+          return {
+            id: taskListModel.id,
+            name: taskListModel.name,
+            startDate: toDateOrNull(taskListModel.startDate),
+            dueDate: toDateOrNull(taskListModel.dueDate),
+            isDueCompleted: !!taskListModel.isDueCompleted,
+            tasksTotal: taskRefs.length,
+            tasksCompletedCount: taskRefs.filter((task) => task.isCompleted).length,
+          };
+        });
+
+      return {
+        cardId: cardModel.id,
+        cardName: cardModel.name,
+        listId: cardModel.listId,
+        listName: cardModel.list ? cardModel.list.name : null,
+        startDate: toDateOrNull(cardModel.startDate),
+        dueDate: toDateOrNull(cardModel.dueDate),
+        isDueCompleted: !!cardModel.isDueCompleted,
+        userIds: cardModel.users.toRefArray().map((user) => user.id),
+        taskLists,
+      };
+    });
+  },
+);
+
+export default {
+  selectGanttItemsForCurrentBoard,
+};
