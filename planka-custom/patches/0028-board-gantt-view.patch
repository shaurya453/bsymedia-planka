diff --git a/client/src/components/boards/GanttModal/GanttChart/GanttChart.jsx b/client/src/components/boards/GanttModal/GanttChart/GanttChart.jsx
new file mode 100644
index 0000000..afad6ed
--- /dev/null
+++ b/client/src/components/boards/GanttModal/GanttChart/GanttChart.jsx
@@ -0,0 +1,168 @@
+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+import React, { useMemo } from 'react';
+import PropTypes from 'prop-types';
+import addDays from 'date-fns/addDays';
+import differenceInCalendarDays from 'date-fns/differenceInCalendarDays';
+import format from 'date-fns/format';
+import startOfDay from 'date-fns/startOfDay';
+
+import Row from './Row';
+
+import styles from './GanttChart.module.scss';
+
+const DAY_WIDTH = 32;
+const LABEL_WIDTH = 260;
+const MIN_RANGE_DAYS = 14;
+
+// BSY Media: shared horizontal Gantt renderer used by both the Timeline tab
+// (grouped by card) and the Team workload tab (grouped by member) - see
+// GanttModal.jsx. Auto-fits its date range from the rows it's given rather
+// than exposing zoom controls, per the confirmed "auto-fit + scroll" design.
+const GanttChart = React.memo(({ rows, canEdit, emptyMessage }) => {
+  const range = useMemo(() => {
+    const dates = [];
+
+    rows.forEach((row) => {
+      if (row.startDate) {
+        dates.push(row.startDate);
+      }
+
+      if (row.dueDate) {
+        dates.push(row.dueDate);
+      }
+    });
+
+    if (dates.length === 0) {
+      return null;
+    }
+
+    const minDate = startOfDay(new Date(Math.min(...dates.map((date) => date.getTime()))));
+    const maxDate = startOfDay(new Date(Math.max(...dates.map((date) => date.getTime()))));
+
+    const start = addDays(minDate, -1);
+    let end = addDays(maxDate, 1);
+
+    if (differenceInCalendarDays(end, start) + 1 < MIN_RANGE_DAYS) {
+      end = addDays(start, MIN_RANGE_DAYS - 1);
+    }
+
+    const totalDays = differenceInCalendarDays(end, start) + 1;
+
+    const dayCells = [];
+    for (let i = 0; i < totalDays; i += 1) {
+      dayCells.push(addDays(start, i));
+    }
+
+    const monthSegments = [];
+    dayCells.forEach((date) => {
+      const monthKey = format(date, 'yyyy-MM');
+      const lastSegment = monthSegments[monthSegments.length - 1];
+
+      if (lastSegment && lastSegment.key === monthKey) {
+        lastSegment.days += 1;
+      } else {
+        monthSegments.push({ key: monthKey, label: format(date, 'MMMM yyyy'), days: 1 });
+      }
+    });
+
+    const today = startOfDay(new Date());
+    const todayOffset =
+      today >= start && today <= end ? differenceInCalendarDays(today, start) : null;
+
+    return {
+      start,
+      totalDays,
+      dayCells,
+      monthSegments,
+      todayOffset,
+    };
+  }, [rows]);
+
+  if (!range) {
+    return <div className={styles.empty}>{emptyMessage}</div>;
+  }
+
+  const chartWidth = range.totalDays * DAY_WIDTH;
+
+  return (
+    <div className={styles.wrapper}>
+      <div className={styles.scroller}>
+        <div className={styles.inner} style={{ width: LABEL_WIDTH + chartWidth }}>
+          <div className={styles.header}>
+            <div className={styles.headerLabel} style={{ width: LABEL_WIDTH }} />
+            <div className={styles.headerTrack} style={{ width: chartWidth }}>
+              <div className={styles.monthRow}>
+                {range.monthSegments.map((segment) => (
+                  <div
+                    key={segment.key}
+                    className={styles.monthCell}
+                    style={{ width: segment.days * DAY_WIDTH }}
+                  >
+                    {segment.label}
+                  </div>
+                ))}
+              </div>
+              <div className={styles.dayRow}>
+                {range.dayCells.map((date) => (
+                  <div
+                    key={date.toISOString()}
+                    className={styles.dayCell}
+                    style={{ width: DAY_WIDTH }}
+                  >
+                    {format(date, 'd')}
+                  </div>
+                ))}
+              </div>
+            </div>
+          </div>
+          <div className={styles.body}>
+            {range.todayOffset !== null && (
+              <div
+                className={styles.todayLine}
+                style={{ left: LABEL_WIDTH + range.todayOffset * DAY_WIDTH + DAY_WIDTH / 2 }}
+              />
+            )}
+            {rows.map((row) => (
+              <Row
+                key={row.key}
+                label={row.label}
+                isGroupHeader={row.isGroupHeader}
+                isGroupBoundary={row.isGroupBoundary}
+                startDate={row.startDate}
+                dueDate={row.dueDate}
+                cardId={row.cardId}
+                taskListId={row.taskListId}
+                rangeStart={range.start}
+                dayWidth={DAY_WIDTH}
+                canEdit={canEdit}
+              />
+            ))}
+          </div>
+        </div>
+      </div>
+    </div>
+  );
+});
+
+GanttChart.propTypes = {
+  rows: PropTypes.arrayOf(
+    PropTypes.shape({
+      key: PropTypes.string.isRequired,
+      label: PropTypes.node.isRequired,
+      isGroupHeader: PropTypes.bool.isRequired,
+      isGroupBoundary: PropTypes.bool.isRequired,
+      startDate: PropTypes.instanceOf(Date),
+      dueDate: PropTypes.instanceOf(Date),
+      cardId: PropTypes.string,
+      taskListId: PropTypes.string,
+    }),
+  ).isRequired,
+  canEdit: PropTypes.bool.isRequired,
+  emptyMessage: PropTypes.string.isRequired,
+};
+
+export default GanttChart;
