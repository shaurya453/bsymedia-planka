@@ -0,0 +1,187 @@
+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+import React, { useMemo } from 'react';
+import PropTypes from 'prop-types';
+import { useSelector } from 'react-redux';
+import { useTranslation } from 'react-i18next';
+import { Icon } from 'semantic-ui-react';
+import startOfDay from 'date-fns/startOfDay';
+
+import selectors from '../../../../selectors';
+import { usePopupInClosableContext } from '../../../../hooks';
+import { BoardMembershipRoles } from '../../../../constants/Enums';
+import EditDueDateStep from '../../../cards/EditDueDateStep';
+import DueDateChip from '../../../cards/DueDateChip';
+import UserAvatar from '../../../users/UserAvatar';
+
+import styles from './Schedule.module.scss';
+
+const ScheduleEntry = React.memo(({ entry, canEdit }) => {
+  const EditDatesPopup = usePopupInClosableContext(EditDueDateStep);
+
+  const content = (
+    <div className={styles.entry}>
+      <Icon
+        name={entry.type === 'card' ? 'file outline' : 'check square outline'}
+        className={styles.entryIcon}
+      />
+      <span className={styles.entryName}>
+        {entry.name}
+        {entry.type === 'taskList' && (
+          <span className={styles.entryCardName}> · {entry.cardName}</span>
+        )}
+      </span>
+      <span className={styles.dates}>
+        {entry.startDate && (
+          <DueDateChip size="tiny" value={entry.startDate} isCompleted={false} withStatus={false} />
+        )}
+        {entry.dueDate && (
+          <DueDateChip
+            size="tiny"
+            withStatusIcon
+            value={entry.dueDate}
+            isCompleted={entry.isDueCompleted}
+            withStatus
+          />
+        )}
+      </span>
+      {entry.type === 'card' && entry.userIds.length > 0 && (
+        <span className={styles.avatars}>
+          {entry.userIds.map((userId) => (
+            <UserAvatar key={userId} id={userId} size="tiny" />
+          ))}
+        </span>
+      )}
+    </div>
+  );
+
+  if (!canEdit) {
+    return content;
+  }
+
+  return (
+    <EditDatesPopup
+      cardId={entry.type === 'card' ? entry.cardId : undefined}
+      taskListId={entry.type === 'taskList' ? entry.taskListId : undefined}
+    >
+      <button type="button" className={styles.entryButton}>
+        {content}
+      </button>
+    </EditDatesPopup>
+  );
+});
+
+ScheduleEntry.propTypes = {
+  entry: PropTypes.shape({
+    key: PropTypes.string.isRequired,
+    type: PropTypes.oneOf(['card', 'taskList']).isRequired,
+    name: PropTypes.string.isRequired,
+    cardName: PropTypes.string,
+    startDate: PropTypes.instanceOf(Date),
+    dueDate: PropTypes.instanceOf(Date),
+    isDueCompleted: PropTypes.bool.isRequired,
+    cardId: PropTypes.string,
+    taskListId: PropTypes.string,
+    userIds: PropTypes.arrayOf(PropTypes.string),
+  }).isRequired,
+  canEdit: PropTypes.bool.isRequired,
+};
+
+// BSY Media: agenda-style view, every dated card/checklist flattened and
+// grouped by day (due date, falling back to start date) instead of by
+// card/member - complements Timeline for "what's happening when".
+const Schedule = React.memo(() => {
+  const items = useSelector(selectors.selectGanttItemsForCurrentBoard);
+
+  const canEdit = useSelector((state) => {
+    const boardMembership = selectors.selectCurrentUserMembershipForCurrentBoard(state);
+    return !!boardMembership && boardMembership.role === BoardMembershipRoles.EDITOR;
+  });
+
+  const [t] = useTranslation();
+
+  const sections = useMemo(() => {
+    const entries = [];
+
+    items.forEach((item) => {
+      const cardDate = item.dueDate || item.startDate;
+
+      if (cardDate) {
+        entries.push({
+          key: `card:${item.cardId}`,
+          date: cardDate,
+          type: 'card',
+          name: item.cardName,
+          startDate: item.startDate,
+          dueDate: item.dueDate,
+          isDueCompleted: item.isDueCompleted,
+          cardId: item.cardId,
+          userIds: item.userIds,
+        });
+      }
+
+      item.taskLists.forEach((taskList) => {
+        const taskListDate = taskList.dueDate || taskList.startDate;
+
+        if (taskListDate) {
+          entries.push({
+            key: `taskList:${taskList.id}`,
+            date: taskListDate,
+            type: 'taskList',
+            name: taskList.name,
+            cardName: item.cardName,
+            startDate: taskList.startDate,
+            dueDate: taskList.dueDate,
+            isDueCompleted: taskList.isDueCompleted,
+            taskListId: taskList.id,
+            userIds: [],
+          });
+        }
+      });
+    });
+
+    entries.sort((a, b) => a.date.getTime() - b.date.getTime());
+
+    const groups = [];
+
+    entries.forEach((entry) => {
+      const dayKey = startOfDay(entry.date).toISOString();
+      const lastGroup = groups[groups.length - 1];
+
+      if (lastGroup && lastGroup.key === dayKey) {
+        lastGroup.entries.push(entry);
+      } else {
+        groups.push({ key: dayKey, date: entry.date, entries: [entry] });
+      }
+    });
+
+    return groups;
+  }, [items]);
+
+  if (sections.length === 0) {
+    return <div className={styles.empty}>{t('common.noDatedCardsOrChecklistsYet')}</div>;
+  }
+
+  return (
+    <div className={styles.wrapper}>
+      {sections.map((section) => (
+        <div key={section.key} className={styles.section}>
+          <div className={styles.sectionHeader}>
+            {t('format:date', {
+              postProcess: 'formatDate',
+              value: section.date,
+            })}
+          </div>
+          {section.entries.map((entry) => (
+            <ScheduleEntry key={entry.key} entry={entry} canEdit={canEdit} />
+          ))}
+        </div>
+      ))}
+    </div>
+  );
+});
+
+export default Schedule;
