+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+import React from 'react';
+import PropTypes from 'prop-types';
+import { useTranslation } from 'react-i18next';
+import { Button, Icon } from 'semantic-ui-react';
+
+import Item from './Item';
+
+import styles from './AssignedMembers.module.scss';
+
+// BSY Media: replaces the old row-of-circular-avatars layout with a proper
+// list (avatar + name per row, like the board Share modal's MembersList),
+// scrolling internally past a handful of rows instead of wrapping the
+// sidebar ever taller.
+const AssignedMembers = React.memo(
+  ({ userIds, canEdit, MembershipsPopup, onUserSelect, onUserDeselect }) => {
+    const [t] = useTranslation();
+
+    return (
+      <div className={styles.wrapper}>
+        {userIds.length > 0 && (
+          <div className={styles.list}>
+            {userIds.map((userId) => (
+              <Item key={userId} id={userId} />
+            ))}
+          </div>
+        )}
+        {canEdit && (
+          <MembershipsPopup
+            currentUserIds={userIds}
+            onUserSelect={onUserSelect}
+            onUserDeselect={onUserDeselect}
+          >
+            <Button type="button" fluid basic className={styles.addButton}>
+              <Icon fitted name="add user" />
+              {t('action.addMember')}
+            </Button>
+          </MembershipsPopup>
+        )}
+      </div>
+    );
+  },
+);
+
+AssignedMembers.propTypes = {
+  userIds: PropTypes.arrayOf(PropTypes.string).isRequired,
+  canEdit: PropTypes.bool.isRequired,
+  MembershipsPopup: PropTypes.elementType.isRequired,
+  onUserSelect: PropTypes.func.isRequired,
+  onUserDeselect: PropTypes.func.isRequired,
+};
+
+export default AssignedMembers;
