+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+// BSY Media: project managers and instance admins get automatic editor
+// rights on every board in their scope, without needing an explicit
+// BoardMembership row. Mirrors the existing read-access bypass in
+// boards/show.js (admins are excluded from personally-owned projects,
+// matching that same nuance).
+module.exports = {
+  inputs: {
+    id: {
+      type: 'string',
+      required: true,
+    },
+    boardId: {
+      type: 'string',
+      required: true,
+    },
+  },
+
+  async fn(inputs) {
+    const boardMembership = await BoardMembership.qm.getOneByBoardIdAndUserId(
+      inputs.boardId,
+      inputs.id,
+    );
+
+    if (boardMembership && boardMembership.role === BoardMembership.Roles.EDITOR) {
+      return true;
+    }
+
+    const { project } = await sails.helpers.boards.getPathToProjectById(inputs.boardId);
+    const user = await User.qm.getOneById(inputs.id);
+
+    if (user.role === User.Roles.ADMIN && !project.ownerProjectManagerId) {
+      return true;
+    }
+
+    return sails.helpers.users.isProjectManager(inputs.id, project.id);
+  },
+};
