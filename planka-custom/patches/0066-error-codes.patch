diff --git a/client/src/utils/get-error-code.js b/client/src/utils/get-error-code.js
new file mode 100644
index 0000000..7fdd837
--- /dev/null
+++ b/client/src/utils/get-error-code.js
@@ -0,0 +1,28 @@
+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+// BSY Media: turns an otherwise-opaque error string into a short, stable
+// identifier - the same underlying message always produces the same code,
+// so a user can report "Code: K3F9A" and it's immediately searchable/
+// correlatable, without echoing raw backend text on surfaces that are
+// public/unauthenticated (e.g. the login and sign-up forms). The un-hashed
+// value is also logged to the console, so anyone who can check devtools
+// (or a screen-share) still sees the real message behind the code.
+const getErrorCode = (detail) => {
+  const value = detail == null ? 'UNKNOWN' : String(detail);
+
+  let hash = 0;
+  for (let i = 0; i < value.length; i += 1) {
+    hash = (hash * 31 + value.charCodeAt(i)) | 0;
+  }
+
+  const code = Math.abs(hash).toString(36).toUpperCase().padStart(5, '0').slice(0, 5);
+
+  console.error(`[Error ${code}]`, value); // eslint-disable-line no-console
+
+  return code;
+};
+
+export default getErrorCode;
