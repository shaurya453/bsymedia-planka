+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+// BSY Media: picks a legible list-header text color for a given background
+// hex, reusing the same luminance formula/threshold already used for
+// project-background scrim detection (see get-background-lightness.js).
+// Returns the existing hardcoded light-mode (#17394d) or dark-mode
+// (#b6c2cf) .headerName text colors from List.module.scss, whichever
+// contrasts better against the given background.
+
+import { getLuminance, isLuminanceLight } from './get-background-lightness';
+
+const LIGHT_MODE_TEXT_COLOR = '#17394d';
+const DARK_MODE_TEXT_COLOR = '#b6c2cf';
+
+const getContrastTextColor = (hex) => {
+  const r = parseInt(hex.substring(1, 3), 16);
+  const g = parseInt(hex.substring(3, 5), 16);
+  const b = parseInt(hex.substring(5, 7), 16);
+
+  const luminance = getLuminance(r, g, b);
+
+  return isLuminanceLight(luminance) ? LIGHT_MODE_TEXT_COLOR : DARK_MODE_TEXT_COLOR;
+};
+
+export default getContrastTextColor;
