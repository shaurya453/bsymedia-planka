diff --git a/client/src/components/common/ColorWheelPicker/ColorWheelPicker.jsx b/client/src/components/common/ColorWheelPicker/ColorWheelPicker.jsx
new file mode 100644
index 0000000..aa42449
--- /dev/null
+++ b/client/src/components/common/ColorWheelPicker/ColorWheelPicker.jsx
@@ -0,0 +1,423 @@
+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+import React, { useCallback, useEffect, useRef, useState } from 'react';
+import PropTypes from 'prop-types';
+
+import { hexToHsv, hsvToHex, hsvToRgb, isValidHex } from './color-math';
+
+import styles from './ColorWheelPicker.module.scss';
+
+const RING_WIDTH = 22;
+const RING_OUTER_MARGIN = 4;
+const HANDLE_RADIUS = 6;
+
+// Angle convention used throughout this file: 0deg points to the right (+x axis) and angles
+// increase clockwise on screen (i.e. standard math angle with the y axis flipped, since canvas
+// y grows downward). This is purely an internal convention: as long as painting, hit-testing and
+// handle placement all agree, the exact direction doesn't matter.
+const angleFromCenter = (dx, dy) => {
+  let degrees = (Math.atan2(dy, dx) * 180) / Math.PI;
+  if (degrees < 0) {
+    degrees += 360;
+  }
+  return degrees;
+};
+
+const getTriangleVertices = (hue, triangleRadius) => {
+  const hueAngleRad = (hue * Math.PI) / 180;
+  const whiteAngleRad = hueAngleRad + (2 * Math.PI) / 3;
+  const blackAngleRad = hueAngleRad - (2 * Math.PI) / 3;
+
+  return {
+    huePoint: {
+      x: triangleRadius * Math.cos(hueAngleRad),
+      y: triangleRadius * Math.sin(hueAngleRad),
+    },
+    whitePoint: {
+      x: triangleRadius * Math.cos(whiteAngleRad),
+      y: triangleRadius * Math.sin(whiteAngleRad),
+    },
+    blackPoint: {
+      x: triangleRadius * Math.cos(blackAngleRad),
+      y: triangleRadius * Math.sin(blackAngleRad),
+    },
+  };
+};
+
+// Barycentric coordinates of point p relative to triangle (a, b, c). Returns weights that sum to
+// 1 when p is inside the triangle (each in [0, 1]); weights can go negative/over 1 outside it.
+const toBarycentric = (p, a, b, c) => {
+  const denom = (b.y - c.y) * (a.x - c.x) + (c.x - b.x) * (a.y - c.y);
+
+  const wa = ((b.y - c.y) * (p.x - c.x) + (c.x - b.x) * (p.y - c.y)) / denom;
+  const wb = ((c.y - a.y) * (p.x - c.x) + (a.x - c.x) * (p.y - c.y)) / denom;
+  const wc = 1 - wa - wb;
+
+  return { wa, wb, wc };
+};
+
+// Saturation/value derived from barycentric weights against (huePoint, whitePoint, blackPoint):
+// wa=1 => pure hue (s=1, v=1); wb=1 => white (s=0, v=1); wc=1 => black (v=0).
+const barycentricToSv = ({ wa, wb }) => {
+  const v = wa + wb;
+  const s = v === 0 ? 0 : wa / v;
+
+  return {
+    s: Math.min(Math.max(s, 0), 1),
+    v: Math.min(Math.max(v, 0), 1),
+  };
+};
+
+const svToBarycentric = (s, v) => {
+  const wa = s * v;
+  const wb = v - wa;
+  const wc = 1 - v;
+
+  return { wa, wb, wc };
+};
+
+// Clamp an out-of-triangle barycentric coordinate to the nearest point still inside the triangle.
+const clampBarycentric = ({ wa, wb, wc }) => {
+  let a = wa;
+  let b = wb;
+  let c = wc;
+
+  if (a >= 0 && b >= 0 && c >= 0) {
+    return { wa: a, wb: b, wc: c };
+  }
+
+  a = Math.max(a, 0);
+  b = Math.max(b, 0);
+  c = Math.max(c, 0);
+
+  const sum = a + b + c;
+  if (sum === 0) {
+    return { wa: 1 / 3, wb: 1 / 3, wc: 1 / 3 };
+  }
+
+  return { wa: a / sum, wb: b / sum, wc: c / sum };
+};
+
+const paintRing = (imageData, size, outerRadius, innerRadius) => {
+  const center = size / 2;
+  const { data } = imageData;
+
+  for (let y = 0; y < size; y += 1) {
+    for (let x = 0; x < size; x += 1) {
+      const dx = x + 0.5 - center;
+      const dy = y + 0.5 - center;
+      const distance = Math.sqrt(dx * dx + dy * dy);
+
+      const index = (y * size + x) * 4;
+
+      if (distance <= outerRadius && distance >= innerRadius) {
+        const hue = angleFromCenter(dx, dy);
+        const { r, g, b } = hsvToRgb({ h: hue, s: 1, v: 1 });
+
+        data[index] = r;
+        data[index + 1] = g;
+        data[index + 2] = b;
+        data[index + 3] = 255;
+      } else {
+        data[index] = 0;
+        data[index + 1] = 0;
+        data[index + 2] = 0;
+        data[index + 3] = 0;
+      }
+    }
+  }
+};
+
+const paintTriangle = (imageData, size, hue, triangleRadius) => {
+  const center = size / 2;
+  const { data } = imageData;
+
+  const { huePoint, whitePoint, blackPoint } = getTriangleVertices(hue, triangleRadius);
+  const hueRgb = hsvToRgb({ h: hue, s: 1, v: 1 });
+
+  for (let y = 0; y < size; y += 1) {
+    for (let x = 0; x < size; x += 1) {
+      const dx = x + 0.5 - center;
+      const dy = y + 0.5 - center;
+
+      const { wa, wb, wc } = toBarycentric({ x: dx, y: dy }, huePoint, whitePoint, blackPoint);
+
+      if (wa >= -0.002 && wb >= -0.002 && wc >= -0.002) {
+        const r = wa * hueRgb.r + wb * 255 + wc * 0;
+        const g = wa * hueRgb.g + wb * 255 + wc * 0;
+        const b = wa * hueRgb.b + wb * 255 + wc * 0;
+
+        const index = (y * size + x) * 4;
+        data[index] = r;
+        data[index + 1] = g;
+        data[index + 2] = b;
+        data[index + 3] = 255;
+      }
+    }
+  }
+};
+
+const drawHandle = (ctx, x, y) => {
+  ctx.beginPath();
+  ctx.arc(x, y, HANDLE_RADIUS, 0, 2 * Math.PI);
+  ctx.fillStyle = '#ffffff';
+  ctx.fill();
+  ctx.lineWidth = 2;
+  ctx.strokeStyle = '#222222';
+  ctx.stroke();
+};
+
+const ColorWheelPicker = React.memo(({ value, onChange, size }) => {
+  const [hsv, setHsv] = useState(() => hexToHsv(value || '#000000'));
+  const [hexInput, setHexInput] = useState(() => (value ? value.toLowerCase() : '#000000'));
+
+  const canvasRef = useRef(null);
+  const ringImageDataRef = useRef(null);
+  const isDraggingRef = useRef(false);
+  const dragModeRef = useRef(null); // 'hue' | 'sv'
+
+  const outerRadius = size / 2 - RING_OUTER_MARGIN;
+  const innerRadius = outerRadius - RING_WIDTH;
+  const triangleRadius = innerRadius - 2;
+
+  // Keep the free-typed hex input in sync when the HSV state changes from a drag/pointer
+  // interaction, without fighting the user's own in-progress typing.
+  const lastEmittedHexRef = useRef(hexInput);
+
+  // Sync internal HSV state from the `value` prop, but only when the change originated from
+  // OUTSIDE (not from our own drag/typing), so we don't fight an in-progress user gesture.
+  useEffect(() => {
+    if (isDraggingRef.current) {
+      return;
+    }
+
+    if (!value || !isValidHex(value)) {
+      return;
+    }
+
+    const normalizedValue = value.toLowerCase();
+    if (normalizedValue === lastEmittedHexRef.current) {
+      return;
+    }
+
+    lastEmittedHexRef.current = normalizedValue;
+    setHsv(hexToHsv(normalizedValue));
+    setHexInput(normalizedValue);
+  }, [value]);
+
+  const emitChange = useCallback(
+    (nextHsv) => {
+      const hex = hsvToHex(nextHsv);
+      lastEmittedHexRef.current = hex;
+      setHexInput(hex);
+      onChange(hex);
+    },
+    [onChange],
+  );
+
+  // Repaint the whole canvas (ring + triangle + handles) whenever the current color changes.
+  useEffect(() => {
+    const canvas = canvasRef.current;
+    if (!canvas) {
+      return;
+    }
+
+    const ctx = canvas.getContext('2d');
+
+    if (!ringImageDataRef.current) {
+      const ringImageData = ctx.createImageData(size, size);
+      paintRing(ringImageData, size, outerRadius, innerRadius);
+      ringImageDataRef.current = ringImageData;
+    }
+
+    const triangleImageData = ctx.createImageData(size, size);
+    triangleImageData.data.set(ringImageDataRef.current.data);
+    paintTriangle(triangleImageData, size, hsv.h, triangleRadius);
+
+    ctx.clearRect(0, 0, size, size);
+    ctx.putImageData(triangleImageData, 0, 0);
+
+    const center = size / 2;
+
+    // Hue handle position, on the middle of the ring band.
+    const ringHandleRadius = (outerRadius + innerRadius) / 2;
+    const hueAngleRad = (hsv.h * Math.PI) / 180;
+    const hueHandleX = center + ringHandleRadius * Math.cos(hueAngleRad);
+    const hueHandleY = center + ringHandleRadius * Math.sin(hueAngleRad);
+    drawHandle(ctx, hueHandleX, hueHandleY);
+
+    // Saturation/value handle position, from barycentric weights of the current s/v.
+    const { huePoint, whitePoint, blackPoint } = getTriangleVertices(hsv.h, triangleRadius);
+    const { wa, wb, wc } = svToBarycentric(hsv.s, hsv.v);
+    const svX = center + wa * huePoint.x + wb * whitePoint.x + wc * blackPoint.x;
+    const svY = center + wa * huePoint.y + wb * whitePoint.y + wc * blackPoint.y;
+    drawHandle(ctx, svX, svY);
+  }, [hsv, size, outerRadius, innerRadius, triangleRadius]);
+
+  const handlePointerMove = useCallback(
+    (clientX, clientY) => {
+      const canvas = canvasRef.current;
+      if (!canvas) {
+        return;
+      }
+
+      const rect = canvas.getBoundingClientRect();
+      const scaleX = size / rect.width;
+      const scaleY = size / rect.height;
+
+      const center = size / 2;
+      const x = (clientX - rect.left) * scaleX;
+      const y = (clientY - rect.top) * scaleY;
+      const dx = x - center;
+      const dy = y - center;
+
+      if (dragModeRef.current === 'hue') {
+        const hue = angleFromCenter(dx, dy);
+        setHsv((prevHsv) => {
+          const nextHsv = { ...prevHsv, h: hue };
+          emitChange(nextHsv);
+          return nextHsv;
+        });
+      } else if (dragModeRef.current === 'sv') {
+        setHsv((prevHsv) => {
+          const { huePoint, whitePoint, blackPoint } = getTriangleVertices(
+            prevHsv.h,
+            triangleRadius,
+          );
+          const barycentric = toBarycentric({ x: dx, y: dy }, huePoint, whitePoint, blackPoint);
+          const clamped = clampBarycentric(barycentric);
+          const { s, v } = barycentricToSv(clamped);
+
+          const nextHsv = { ...prevHsv, s, v };
+          emitChange(nextHsv);
+          return nextHsv;
+        });
+      }
+    },
+    [size, triangleRadius, emitChange],
+  );
+
+  const stopDragRef = useRef(null);
+
+  const handlePointerDown = useCallback(
+    (event) => {
+      const canvas = canvasRef.current;
+      if (!canvas) {
+        return;
+      }
+
+      const rect = canvas.getBoundingClientRect();
+      const scaleX = size / rect.width;
+      const scaleY = size / rect.height;
+
+      const center = size / 2;
+      const x = (event.clientX - rect.left) * scaleX;
+      const y = (event.clientY - rect.top) * scaleY;
+      const dx = x - center;
+      const dy = y - center;
+      const distance = Math.sqrt(dx * dx + dy * dy);
+
+      let mode = null;
+      if (distance >= innerRadius && distance <= outerRadius) {
+        mode = 'hue';
+      } else if (distance < innerRadius) {
+        // Anything inside the ring hole is treated as an sv-drag; out-of-triangle points are
+        // clamped to the nearest valid in-triangle point on every subsequent move.
+        mode = 'sv';
+      }
+
+      if (!mode) {
+        return;
+      }
+
+      dragModeRef.current = mode;
+      isDraggingRef.current = true;
+
+      handlePointerMove(event.clientX, event.clientY);
+
+      const onMove = (moveEvent) => {
+        handlePointerMove(moveEvent.clientX, moveEvent.clientY);
+      };
+
+      const onUp = () => {
+        isDraggingRef.current = false;
+        dragModeRef.current = null;
+        window.removeEventListener('pointermove', onMove);
+        window.removeEventListener('pointerup', onUp);
+        window.removeEventListener('pointercancel', onUp);
+        stopDragRef.current = null;
+      };
+
+      stopDragRef.current = onUp;
+
+      window.addEventListener('pointermove', onMove);
+      window.addEventListener('pointerup', onUp);
+      window.addEventListener('pointercancel', onUp);
+    },
+    [size, innerRadius, outerRadius, handlePointerMove],
+  );
+
+  useEffect(
+    () => () => {
+      if (stopDragRef.current) {
+        window.removeEventListener('pointermove', stopDragRef.current);
+        window.removeEventListener('pointerup', stopDragRef.current);
+        window.removeEventListener('pointercancel', stopDragRef.current);
+      }
+    },
+    [],
+  );
+
+  const handleHexInputChange = useCallback(
+    (event) => {
+      const nextValue = event.target.value;
+      setHexInput(nextValue);
+
+      if (isValidHex(nextValue)) {
+        const normalizedValue = nextValue.toLowerCase();
+        const nextHsv = hexToHsv(normalizedValue);
+
+        lastEmittedHexRef.current = normalizedValue;
+        setHsv(nextHsv);
+        onChange(normalizedValue);
+      }
+    },
+    [onChange],
+  );
+
+  return (
+    <div className={styles.wrapper}>
+      <canvas
+        ref={canvasRef}
+        width={size}
+        height={size}
+        className={styles.canvas}
+        onPointerDown={handlePointerDown}
+      />
+      <input
+        type="text"
+        className={styles.hexInput}
+        value={hexInput}
+        onChange={handleHexInputChange}
+        maxLength={7}
+        spellCheck={false}
+      />
+    </div>
+  );
+});
+
+ColorWheelPicker.propTypes = {
+  value: PropTypes.string,
+  onChange: PropTypes.func.isRequired,
+  size: PropTypes.number,
+};
+
+ColorWheelPicker.defaultProps = {
+  value: undefined,
+  size: 220,
+};
+
+export default ColorWheelPicker;
