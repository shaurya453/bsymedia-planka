+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+import React, { useCallback } from 'react';
+import PropTypes from 'prop-types';
+import classNames from 'classnames';
+import { Button } from 'semantic-ui-react';
+import { useTranslation } from 'react-i18next';
+import { Popup } from '../../../../lib/custom-ui';
+
+import GANTT_TASK_LIST_COLORS from '../../../../constants/GanttTaskListColors';
+
+import styles from './ColorPickerStep.module.scss';
+
+// BSY Media: Tier 3 per-checklist color picker for the Timeline tab -
+// mirrors lists/List/EditColorStep.jsx's shape (a Popup.Header/Content pair
+// with a swatch grid + a clear button) but selects a raw hex value instead
+// of one of Planka's own named ListColors, since the choice here is saved
+// to invite-service/planka_ops, not to a Planka record.
+const ColorPickerStep = React.memo(({ color, onSelect, onClear, onClose }) => {
+  const [t] = useTranslation();
+
+  const handleSelectClick = useCallback(
+    (_, { value }) => {
+      onSelect(value);
+      onClose();
+    },
+    [onSelect, onClose],
+  );
+
+  const handleClearClick = useCallback(() => {
+    onClear();
+    onClose();
+  }, [onClear, onClose]);
+
+  return (
+    <>
+      <Popup.Header>{t('common.checklistColor', { context: 'title' })}</Popup.Header>
+      <Popup.Content>
+        <div className={styles.swatches}>
+          {GANTT_TASK_LIST_COLORS.map((swatch) => (
+            <Button
+              key={swatch}
+              type="button"
+              value={swatch}
+              className={classNames(styles.swatch, swatch === color && styles.swatchActive)}
+              style={{ background: swatch }}
+              onClick={handleSelectClick}
+            />
+          ))}
+        </div>
+        {color && (
+          <Button
+            fluid
+            content={t('action.removeColor')}
+            className={styles.clearButton}
+            onClick={handleClearClick}
+          />
+        )}
+      </Popup.Content>
+    </>
+  );
+});
+
+ColorPickerStep.propTypes = {
+  color: PropTypes.string,
+  onSelect: PropTypes.func.isRequired,
+  onClear: PropTypes.func.isRequired,
+  onClose: PropTypes.func.isRequired,
+};
+
+ColorPickerStep.defaultProps = {
+  color: null,
+};
+
+export default ColorPickerStep;
