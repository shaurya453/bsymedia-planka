diff --git a/client/src/constants/LabelColorGrid.js b/client/src/constants/LabelColorGrid.js
new file mode 100644
index 0000000..818dfab
--- /dev/null
+++ b/client/src/constants/LabelColorGrid.js
@@ -0,0 +1,49 @@
+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+// BSY Media: swatch-picker layout for the 42-color palette, computed (not guessed) from each
+// color's real HSL values. Columns run left-to-right across the visible spectrum (red -> orange
+// -> yellow -> green -> teal -> blue -> purple -> pink), with a trailing achromatic column; within
+// each column, colors are sorted lightest (top) to darkest (bottom) - i.e. tints above, shades
+// below. `pirate-gold` and `silver-glint` are rendered as metallic gradients rather than flat
+// colors, so they're kept out of this matrix entirely and shown in their own "special" section
+// instead, alongside the custom color wheel (see Editor.jsx / EditColorStep.jsx).
+const HUE_COLUMNS = [
+  ['apricot-red', 'light-cocoa', 'shady-rust'],
+  ['desert-sand', 'light-orange', 'light-mud', 'pumpkin-orange', 'orange-peel'],
+  ['fresh-salad', 'egg-yellow', 'autumn-leafs', 'sunny-grass'],
+  ['modern-green', 'tank-green', 'bright-moss', 'wet-moss'],
+  ['morning-sky', 'lagoon-blue', 'french-coast', 'coral-green', 'turquoise-sea'],
+  [
+    'summer-sky',
+    'antique-blue',
+    'lilac-eyes',
+    'gun-metal',
+    'navy-blue',
+    'midnight-blue',
+    'deep-ocean',
+  ],
+  ['sugar-plum', 'lavender-fields', 'sweet-lilac'],
+  ['piggy-red', 'pink-tulip', 'berry-red', 'red-burgundy'],
+  ['grey-stone', 'light-concrete', 'wet-rock', 'dark-granite', 'muddy-grey'],
+];
+
+export const SPECIAL_COLORS = ['pirate-gold', 'silver-glint'];
+
+export const GRID_COLUMN_COUNT = HUE_COLUMNS.length;
+export const GRID_ROW_COUNT = Math.max(...HUE_COLUMNS.map((column) => column.length));
+
+// flattened for rendering: one entry per swatch with its explicit 1-indexed grid coordinates,
+// since columns have different heights and CSS Grid's auto-placement can't express "start a new
+// column early" on its own.
+export const GRID_ITEMS = HUE_COLUMNS.flatMap((column, columnIndex) =>
+  column.map((color, rowIndex) => ({
+    color,
+    column: columnIndex + 1,
+    row: rowIndex + 1,
+  })),
+);
+
+export default HUE_COLUMNS;
