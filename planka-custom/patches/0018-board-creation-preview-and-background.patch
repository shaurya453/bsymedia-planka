+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+:global(#app) {
+  .wrapper {
+    margin-bottom: 16px;
+  }
+
+  .background {
+    // BSY Media: neutral placeholder shown until a background is picked
+    // below - this preview only mirrors the project's real background/theme
+    // once one is actually selected (see ProjectBackground.jsx, which this
+    // mirrors), it isn't itself a stored value.
+    background: linear-gradient(135deg, #4c6ef5, #5c7cfa);
+    border-radius: 8px;
+    display: flex;
+    flex-direction: column;
+    gap: 10px;
+    overflow: hidden;
+    padding: 10px;
+  }
+
+  .header {
+    color: #fff;
+    font-size: 13px;
+    font-weight: bold;
+    overflow: hidden;
+    text-overflow: ellipsis;
+    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
+    white-space: nowrap;
+  }
+
+  .headerLight {
+    color: #17394d;
+    text-shadow: none;
+  }
+
+  .columns {
+    display: flex;
+    gap: 8px;
+  }
+
+  .column {
+    background: #dfe3e6;
+    border-radius: 4px;
+    display: flex;
+    flex: 1;
+    flex-direction: column;
+    gap: 6px;
+    padding: 6px;
+  }
+
+  .columnDark {
+    background: #101204;
+  }
+
+  .card {
+    background: #fff;
+    border-radius: 3px;
+    box-shadow: 0 1px 0 #ccc;
+    height: 14px;
+  }
+
+  .cardDark {
+    background: #242528;
+    box-shadow: 0 1px 0 #1d2125;
+  }
+}
