diff --git a/client/src/components/boards/AddBoardModal/BoardPreview/BoardPreview.jsx b/client/src/components/boards/AddBoardModal/BoardPreview/BoardPreview.jsx
new file mode 100644
index 0000000..42fb307
--- /dev/null
+++ b/client/src/components/boards/AddBoardModal/BoardPreview/BoardPreview.jsx
@@ -0,0 +1,119 @@
+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+import upperFirst from 'lodash/upperFirst';
+import camelCase from 'lodash/camelCase';
+import React, { useEffect, useMemo, useState } from 'react';
+import PropTypes from 'prop-types';
+import classNames from 'classnames';
+import { useSelector } from 'react-redux';
+import { useTranslation } from 'react-i18next';
+
+import selectors from '../../../../selectors';
+import { ProjectBackgroundTypes } from '../../../../constants/Enums';
+import LIGHT_BACKGROUND_GRADIENTS from '../../../../constants/BackgroundGradientLightness';
+import getImageAverageLuminance, {
+  isLuminanceLight,
+} from '../../../../utils/get-background-lightness';
+
+import styles from './BoardPreview.module.scss';
+import globalStyles from '../../../../styles.module.scss';
+
+// BSY Media: new board's background/theme is set on its parent PROJECT (see
+// AddBoardModal.jsx for why - there's no per-board background field). This
+// preview reads the same current-project background/theme state that
+// BackgroundPane writes to, so it updates live as the user picks a
+// background below it, and reuses ProjectBackground.jsx's own light/dark
+// scrim detection (same gradient table + image-luminance sampling) so the
+// header contrast shown here matches what the real board actually renders,
+// rather than a second implementation that could drift out of sync.
+const BoardPreview = React.memo(({ name }) => {
+  const selectBackgroundImageById = useMemo(() => selectors.makeSelectBackgroundImageById(), []);
+
+  const { backgroundImageId, backgroundType, backgroundGradient, cardsDarkModeEnabled } =
+    useSelector(selectors.selectCurrentProject);
+
+  const backgroundImageUrl = useSelector((state) => {
+    if (backgroundType !== ProjectBackgroundTypes.IMAGE) {
+      return null;
+    }
+
+    const backgroundImage = selectBackgroundImageById(state, backgroundImageId);
+
+    return backgroundImage ? backgroundImage.url : null;
+  });
+
+  const [t] = useTranslation();
+  const [isLightBackground, setIsLightBackground] = useState(false);
+
+  useEffect(() => {
+    if (backgroundType === ProjectBackgroundTypes.GRADIENT) {
+      setIsLightBackground(LIGHT_BACKGROUND_GRADIENTS.has(backgroundGradient));
+      return undefined;
+    }
+
+    if (backgroundType === ProjectBackgroundTypes.IMAGE && backgroundImageUrl) {
+      let isCancelled = false;
+
+      getImageAverageLuminance(backgroundImageUrl)
+        .then((luminance) => {
+          if (!isCancelled) {
+            setIsLightBackground(isLuminanceLight(luminance));
+          }
+        })
+        .catch(() => {
+          // Sampling failed (e.g. canvas security error) - keep the default
+          // (dark-background) styling rather than guessing.
+        });
+
+      return () => {
+        isCancelled = true;
+      };
+    }
+
+    setIsLightBackground(false);
+    return undefined;
+  }, [backgroundType, backgroundGradient, backgroundImageUrl]);
+
+  return (
+    <div className={styles.wrapper}>
+      <div
+        className={classNames(
+          styles.background,
+          backgroundType === ProjectBackgroundTypes.GRADIENT &&
+            globalStyles[`background${upperFirst(camelCase(backgroundGradient))}`],
+        )}
+        style={{
+          background: backgroundImageUrl && `url("${backgroundImageUrl}") center / cover`,
+        }}
+      >
+        <div className={classNames(styles.header, isLightBackground && styles.headerLight)}>
+          {name.trim() || t('common.untitledBoard')}
+        </div>
+        <div className={styles.columns}>
+          {[0, 1, 2].map((index) => (
+            <div
+              key={index}
+              className={classNames(styles.column, cardsDarkModeEnabled && styles.columnDark)}
+            >
+              <div className={classNames(styles.card, cardsDarkModeEnabled && styles.cardDark)} />
+              <div className={classNames(styles.card, cardsDarkModeEnabled && styles.cardDark)} />
+            </div>
+          ))}
+        </div>
+      </div>
+    </div>
+  );
+});
+
+BoardPreview.propTypes = {
+  name: PropTypes.string,
+};
+
+BoardPreview.defaultProps = {
+  name: '',
+};
+
+export default BoardPreview;
