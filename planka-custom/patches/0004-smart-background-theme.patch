--- /dev/null
+++ b/client/src/utils/get-background-lightness.js
@@ -0,0 +1,54 @@
+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+// BSY Media: "smart" light/dark background detection, used to darken the
+// header scrim automatically over light backgrounds so text stays legible.
+// Gradients are classified ahead of time (see BackgroundGradientLightness.js
+// - same formula, computed once from their fixed color stops); uploaded
+// images are sampled at runtime since their content is arbitrary.
+
+const LIGHTNESS_THRESHOLD = 140; // 0-255 relative luminance midpoint-ish
+
+const SAMPLE_SIZE = 16; // downscale to keep canvas sampling cheap
+
+// Relative luminance (ITU-R BT.709 coefficients), 0-255 scale.
+const getLuminance = (r, g, b) => 0.2126 * r + 0.7152 * g + 0.0722 * b;
+
+const getImageAverageLuminance = (imageUrl) =>
+  new Promise((resolve, reject) => {
+    const image = new Image();
+    image.crossOrigin = 'anonymous';
+
+    image.onload = () => {
+      try {
+        const canvas = document.createElement('canvas');
+        canvas.width = SAMPLE_SIZE;
+        canvas.height = SAMPLE_SIZE;
+
+        const context = canvas.getContext('2d');
+        context.drawImage(image, 0, 0, SAMPLE_SIZE, SAMPLE_SIZE);
+
+        const { data } = context.getImageData(0, 0, SAMPLE_SIZE, SAMPLE_SIZE);
+
+        let total = 0;
+        let count = 0;
+        for (let i = 0; i < data.length; i += 4) {
+          total += getLuminance(data[i], data[i + 1], data[i + 2]);
+          count += 1;
+        }
+
+        resolve(total / count);
+      } catch (error) {
+        reject(error);
+      }
+    };
+
+    image.onerror = reject;
+    image.src = imageUrl;
+  });
+
+export const isLuminanceLight = (luminance) => luminance > LIGHTNESS_THRESHOLD;
+
+export default getImageAverageLuminance;
