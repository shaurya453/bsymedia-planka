+.wrapper {
+  align-items: center;
+  background: #17394d;
+  border-radius: 6px;
+  bottom: 24px;
+  box-shadow: 0 4px 16px rgba(9, 30, 66, 0.32);
+  color: #fff;
+  display: flex;
+  gap: 12px;
+  left: 50%;
+  padding: 10px 16px;
+  position: fixed;
+  transform: translateX(-50%);
+  z-index: 10;
+}
+
+.count {
+  font-weight: bold;
+  white-space: nowrap;
+}
+
+:global(#app.dark-mode-cards-enabled) {
+  .wrapper {
+    background: #242528;
+  }
+}
