new file mode 100644
index 0000000..ff647f9
--- /dev/null
+++ b/client/src/components/boards/Board/SelectionActionsBar/SelectionActionsBar.jsx
@@ -0,0 +1,80 @@
+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+import React, { useCallback } from 'react';
+import { useDispatch, useSelector } from 'react-redux';
+import { useTranslation } from 'react-i18next';
+import { Button } from 'semantic-ui-react';
+import { usePopup } from '../../../../lib/popup';
+
+import selectors from '../../../../selectors';
+import entryActions from '../../../../entry-actions';
+import { BoardContexts } from '../../../../constants/Enums';
+import ConfirmationStep from '../../../common/ConfirmationStep';
+
+import styles from './SelectionActionsBar.module.scss';
+
+// BSY Media: bulk card selection - a floating bar that appears whenever one
+// or more cards are Ctrl/Shift-selected on the plain Kanban view (see
+// Card.jsx's handleClick and the "selectedCardIds" state in reducers/core.js
+// for how a selection gets built up). "Delete" here means archive - cards
+// move to the board's existing hidden Archive system list rather than being
+// permanently removed, matching the single-card "Archive" action already
+// available from a card's own actions menu.
+const SelectionActionsBar = React.memo(() => {
+  const board = useSelector(selectors.selectCurrentBoard);
+  const selectedCardIds = useSelector(selectors.selectSelectedCardIds);
+
+  const dispatch = useDispatch();
+  const [t] = useTranslation();
+
+  const handleCancelClick = useCallback(() => {
+    dispatch(entryActions.clearCardSelection());
+  }, [dispatch]);
+
+  const handleDeleteConfirm = useCallback(() => {
+    selectedCardIds.forEach((cardId) => {
+      dispatch(entryActions.moveCardToArchive(cardId));
+    });
+
+    dispatch(entryActions.clearCardSelection());
+  }, [selectedCardIds, dispatch]);
+
+  const DeleteConfirmationPopup = usePopup(ConfirmationStep);
+
+  if (board.context !== BoardContexts.BOARD || selectedCardIds.length === 0) {
+    return null;
+  }
+
+  return (
+    <div className={styles.wrapper}>
+      <span className={styles.count}>
+        {t('common.cardsSelectedCount', {
+          count: selectedCardIds.length,
+        })}
+      </span>
+      <Button
+        basic
+        inverted
+        size="small"
+        content={t('action.cancel')}
+        onClick={handleCancelClick}
+      />
+      <DeleteConfirmationPopup
+        title="common.archiveCards"
+        content="common.areYouSureYouWantToArchiveSelectedCards"
+        contentValues={{
+          count: selectedCardIds.length,
+        }}
+        buttonContent="action.archiveCards"
+        onConfirm={handleDeleteConfirm}
+      >
+        <Button negative size="small" content={t('action.delete')} />
+      </DeleteConfirmationPopup>
+    </div>
+  );
+});
+
+export default SelectionActionsBar;
