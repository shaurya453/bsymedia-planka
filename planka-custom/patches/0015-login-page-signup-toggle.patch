diff --git a/client/src/components/common/Login/SignUpForm.jsx b/client/src/components/common/Login/SignUpForm.jsx
new file mode 100644
index 0000000..8c7891c
--- /dev/null
+++ b/client/src/components/common/Login/SignUpForm.jsx
@@ -0,0 +1,179 @@
+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+import isEmail from 'validator/lib/isEmail';
+import React, { useCallback, useEffect, useState } from 'react';
+import PropTypes from 'prop-types';
+import { useTranslation } from 'react-i18next';
+import { Form, Message } from 'semantic-ui-react';
+import { Input } from '../../../lib/custom-ui';
+
+import { useForm, useNestedRef } from '../../../hooks';
+
+import styles from './Content.module.scss';
+
+// BSY Media: replaces the separate invite-service /invite/join webpage -
+// self-signup lives directly on PLANKA's own login page now, toggled via
+// the "New user? Sign up" button. Deliberately ungated (no passphrase/
+// domain restriction), same as the page it replaces - an internal-tool
+// trade-off, not an oversight (see CLAUDE.md).
+const SignUpForm = React.memo(({ onSuccess }) => {
+  const [t] = useTranslation();
+
+  const [data, handleFieldChange] = useForm({
+    name: '',
+    email: '',
+    password: '',
+    passwordConfirmation: '',
+  });
+
+  const [isSubmitting, setIsSubmitting] = useState(false);
+  const [error, setError] = useState(null);
+
+  const [nameFieldRef, handleNameFieldRef] = useNestedRef('inputRef');
+
+  useEffect(() => {
+    nameFieldRef.current.focus({
+      preventScroll: true,
+    });
+  }, [nameFieldRef]);
+
+  const handleSubmit = useCallback(() => {
+    const cleanData = {
+      name: data.name.trim(),
+      email: data.email.trim(),
+      password: data.password,
+    };
+
+    if (!cleanData.name || !cleanData.email || !cleanData.password) {
+      setError({
+        message: t('common.allFieldsAreRequired'),
+      });
+      return;
+    }
+
+    if (!isEmail(cleanData.email)) {
+      setError({
+        message: t('common.invalidEmail'),
+      });
+      return;
+    }
+
+    if (cleanData.password.length < 8) {
+      setError({
+        message: t('common.passwordMustBeAtLeast8Characters'),
+      });
+      return;
+    }
+
+    if (cleanData.password !== data.passwordConfirmation) {
+      setError({
+        message: t('common.passwordsDoNotMatch'),
+      });
+      return;
+    }
+
+    setError(null);
+    setIsSubmitting(true);
+
+    fetch('/invite/api/join', {
+      method: 'POST',
+      headers: {
+        'Content-Type': 'application/json',
+      },
+      body: JSON.stringify(cleanData),
+    })
+      .then((response) => response.json().then((body) => ({ ok: response.ok, body })))
+      .then(({ ok, body }) => {
+        setIsSubmitting(false);
+
+        if (!ok) {
+          setError({
+            message: body.error || t('common.unknownError'),
+          });
+          return;
+        }
+
+        onSuccess(cleanData.email);
+      })
+      .catch(() => {
+        setIsSubmitting(false);
+        setError({
+          message: t('common.serverConnectionFailed'),
+        });
+      });
+  }, [data, onSuccess, t]);
+
+  return (
+    <Form size="large" onSubmit={handleSubmit}>
+      {error && <Message error visible content={error.message} />}
+      <div className={styles.inputWrapper}>
+        <div className={styles.inputLabel}>{t('common.name')}</div>
+        <Input
+          fluid
+          ref={handleNameFieldRef}
+          name="name"
+          value={data.name}
+          maxLength={128}
+          readOnly={isSubmitting}
+          className={styles.input}
+          onChange={handleFieldChange}
+        />
+      </div>
+      <div className={styles.inputWrapper}>
+        <div className={styles.inputLabel}>{t('common.email')}</div>
+        <Input
+          fluid
+          name="email"
+          value={data.email}
+          maxLength={256}
+          readOnly={isSubmitting}
+          className={styles.input}
+          onChange={handleFieldChange}
+        />
+      </div>
+      <div className={styles.inputWrapper}>
+        <div className={styles.inputLabel}>{t('common.password')}</div>
+        <Input.Password
+          fluid
+          name="password"
+          value={data.password}
+          maxLength={256}
+          readOnly={isSubmitting}
+          className={styles.input}
+          onChange={handleFieldChange}
+        />
+        <div className={styles.passwordHint}>{t('common.passwordStrengthHint')}</div>
+      </div>
+      <div className={styles.inputWrapper}>
+        <div className={styles.inputLabel}>{t('common.confirmPassword')}</div>
+        <Input.Password
+          fluid
+          name="passwordConfirmation"
+          value={data.passwordConfirmation}
+          maxLength={256}
+          readOnly={isSubmitting}
+          className={styles.input}
+          onChange={handleFieldChange}
+        />
+      </div>
+      <Form.Button
+        fluid
+        primary
+        icon="right arrow"
+        labelPosition="right"
+        content={t('action.signUp')}
+        loading={isSubmitting}
+        disabled={isSubmitting}
+      />
+    </Form>
+  );
+});
+
+SignUpForm.propTypes = {
+  onSuccess: PropTypes.func.isRequired,
+};
+
+export default SignUpForm;
