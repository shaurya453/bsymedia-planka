new file mode 100644
index 0000000..710dc99
--- /dev/null
+++ b/client/src/components/boards/GanttView/GanttView.jsx
@@ -0,0 +1,146 @@
+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+import React, { useEffect, useMemo, useRef, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { Menu, Tab } from 'semantic-ui-react';
+
+import { useClosable } from '../../../hooks';
+import { ClosableContext } from '../../../contexts';
+import Timeline from '../GanttModal/Timeline';
+import Tasks from '../GanttModal/Tasks';
+import TeamWorkload from '../GanttModal/TeamWorkload';
+import Schedule from '../GanttModal/Schedule';
+
+import styles from './GanttView.module.scss';
+
+// BSY Media: inline board-area replacement for the old fullscreen
+// GanttModal - mounted directly in Board.jsx's Content slot (in place of
+// KanbanContent) instead of as a modal overlay, toggled by GanttButton. The
+// 4 tabs (Timeline/Tasks/TeamWorkload/Schedule) and the shared GanttChart
+// they render are otherwise completely unchanged, reused straight from
+// GanttModal/ rather than duplicated.
+//
+// One real coupling has to be handled here that GanttModal used to provide
+// for free: Row.jsx/Tasks.jsx/Schedule.jsx's click-to-edit date popups go
+// through usePopupInClosableContext, which reads ClosableContext via
+// useContext - GanttModal got a working context value bundled together
+// with its Modal wrapper via useClosableModal(). Without a provider here,
+// ClosableContext falls back to its default [null, null, null] and calling
+// activateClosable() would throw. Fixed by calling the lower-level
+// useClosable() hook directly (the same one useClosableModal itself calls
+// internally) and providing the identical 3-value context shape, with no
+// Modal involved.
+const GanttView = React.memo(() => {
+  const [, activateClosable, deactivateClosable, setIsClosableActive] = useClosable();
+
+  const closableContextValue = useMemo(
+    () => [activateClosable, deactivateClosable, setIsClosableActive],
+    [activateClosable, deactivateClosable, setIsClosableActive],
+  );
+
+  const [t] = useTranslation();
+
+  // BSY Media: Board.jsx's own content slot (Static.module.scss's outer
+  // .wrapper) is deliberately taller than the viewport for Kanban's sake -
+  // "height: 100%" plus a fixed header "margin-top" that's meant to
+  // overflow off-screen and let the *page* scroll, since Kanban's own
+  // content (cards inside each list) never needs a single bounded vertical
+  // scroller of its own. Confirmed live via getBoundingClientRect(): this
+  // wrapper's own cross-axis stretch just faithfully inherits that same
+  // oversized height, which is wrong for Gantt - a genuinely tall single
+  // list of rows that needs its own .scroller (GanttChart.module.scss) to
+  // be the *only* scroll container, not a second one stacked underneath a
+  // page-level scroll. There's no pure-CSS "100vh minus wherever I actually
+  // ended up" primitive here (the exact offset already varies by
+  // favorites-panel state and the promo banner, so hardcoding a calc()
+  // constant the way the old fullscreen GanttModal did would be wrong in at
+  // least one of those states) - so this measures its own real top offset
+  // directly, the same ResizeObserver-driven approach GanttChart.jsx
+  // already uses for the analogous horizontal stretch-to-fill problem.
+  const wrapperRef = useRef(null);
+  const [wrapperHeight, setWrapperHeight] = useState(null);
+
+  useEffect(() => {
+    const wrapper = wrapperRef.current;
+    if (!wrapper) {
+      return undefined;
+    }
+
+    const updateHeight = () => {
+      const { top } = wrapper.getBoundingClientRect();
+      setWrapperHeight(Math.max(240, window.innerHeight - top));
+    };
+
+    updateHeight();
+    window.addEventListener('resize', updateHeight);
+
+    return () => window.removeEventListener('resize', updateHeight);
+  }, []);
+
+  const panes = [
+    {
+      menuItem: (
+        <Menu.Item key="timeline" className={styles.menuItem}>
+          {t('common.timeline', {
+            context: 'title',
+          })}
+        </Menu.Item>
+      ),
+      render: () => <Timeline />,
+    },
+    {
+      menuItem: (
+        <Menu.Item key="tasks" className={styles.menuItem}>
+          {t('common.tasks', {
+            context: 'title',
+          })}
+        </Menu.Item>
+      ),
+      render: () => <Tasks />,
+    },
+    {
+      menuItem: (
+        <Menu.Item key="teamWorkload" className={styles.menuItem}>
+          {t('common.teamWorkload', {
+            context: 'title',
+          })}
+        </Menu.Item>
+      ),
+      render: () => <TeamWorkload />,
+    },
+    {
+      menuItem: (
+        <Menu.Item key="schedule" className={styles.menuItem}>
+          {t('common.schedule', {
+            context: 'title',
+          })}
+        </Menu.Item>
+      ),
+      render: () => <Schedule />,
+    },
+  ];
+
+  return (
+    <ClosableContext.Provider value={closableContextValue}>
+      <div
+        ref={wrapperRef}
+        className={styles.wrapper}
+        style={wrapperHeight ? { height: wrapperHeight } : undefined}
+      >
+        <Tab
+          menu={{
+            secondary: true,
+            pointing: true,
+          }}
+          panes={panes}
+          className={styles.tab}
+        />
+      </div>
+    </ClosableContext.Provider>
+  );
+});
+
+export default GanttView;
diff --git a/client/src/components/boards/GanttView/GanttView.module.scss b/client/src/components/boards/GanttView/GanttView.module.scss
new file mode 100644
index 0000000..aad85fd
--- /dev/null
+++ b/client/src/components/boards/GanttView/GanttView.module.scss
@@ -0,0 +1,56 @@
+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+:global(#app) {
+  .wrapper {
+    // BSY Media: this is a flex item of Board.jsx's own content slot
+    // (Static.module.scss's row-direction ".wrapper.wrapperBoard.wrapperFlex"),
+    // not just a plain block box - without flex: 1 1 auto it only claims its
+    // own content's natural width as a row-flex item (confirmed live via
+    // getBoundingClientRect: 912px instead of the full 1600px viewport) and
+    // never grows to fill the row. min-width: 0 is the standard flex-item
+    // companion fix - without it a flex item's default min-width: auto can
+    // refuse to shrink below its content's intrinsic width in the other
+    // direction.
+    background: #fff;
+    display: flex;
+    flex: 1 1 auto;
+    flex-direction: column;
+    min-width: 0;
+    // height is set inline from GanttView.jsx once the wrapper's real
+    // top offset is measured - see that file's comment for why a plain
+    // "height: 100%" or a hardcoded calc(100vh - Npx) both fall short here.
+    // This 100% is only the pre-measurement fallback for the very first
+    // paint.
+    height: 100%;
+    overflow: hidden;
+    padding: 0 8px;
+  }
+
+  .tab {
+    display: flex;
+    flex: 1 1 auto;
+    flex-direction: column;
+    min-height: 0;
+
+    // overflow: hidden (not auto) - each tab pane's own content (GanttChart's
+    // .scroller) is the intended single scrolling container. A second
+    // overflow: auto here would fight it for scroll ownership and break
+    // position: sticky, which sticks relative to its *nearest* scrolling
+    // ancestor - not necessarily the one you meant. Same fix as
+    // GanttModal.module.scss's identical rule.
+    :global(.tab) {
+      display: flex;
+      flex: 1 1 auto;
+      flex-direction: column;
+      min-height: 0;
+      overflow: hidden;
+    }
+  }
+
+  .menuItem {
+    font-weight: bold;
+  }
+}
