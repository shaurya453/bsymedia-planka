+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+import React, { useCallback, useState } from 'react';
+import PropTypes from 'prop-types';
+import { useTranslation } from 'react-i18next';
+import { Button, Icon, Menu } from 'semantic-ui-react';
+import { Popup } from '../../../../lib/custom-ui';
+
+import { BoardMembershipRoles } from '../../../../constants/Enums';
+import { BoardMembershipRoleIcons } from '../../../../constants/Icons';
+
+import styles from '../SelectPermissionsStep.module.scss';
+
+const ROLES = [BoardMembershipRoles.EDITOR, BoardMembershipRoles.VIEWER];
+
+// BSY Media: bulk-add every user who isn't already on the board, after
+// confirming a single role to apply to all of them.
+const AddAllStep = React.memo(({ count, onConfirm, onBack, onClose }) => {
+  const [t] = useTranslation();
+  const [role, setRole] = useState(BoardMembershipRoles.VIEWER);
+
+  const handleRoleClick = useCallback((_, { value }) => {
+    setRole(value);
+  }, []);
+
+  const handleConfirmClick = useCallback(() => {
+    onConfirm(role);
+    onClose();
+  }, [role, onConfirm, onClose]);
+
+  return (
+    <>
+      <Popup.Header onBack={onBack}>
+        {t('common.addAllMembers', {
+          context: 'title',
+        })}
+      </Popup.Header>
+      <Popup.Content>
+        <div className={styles.settings}>{t('common.addAllMembersConfirmation', { count })}</div>
+        <Menu secondary vertical className={styles.menu}>
+          {ROLES.map((currentRole) => (
+            <Menu.Item
+              key={currentRole}
+              value={currentRole}
+              active={currentRole === role}
+              className={styles.menuItem}
+              onClick={handleRoleClick}
+            >
+              <Icon
+                name={BoardMembershipRoleIcons[currentRole]}
+                className={styles.menuItemIcon}
+              />
+              <div className={styles.menuItemTitle}>{t(`common.${currentRole}`)}</div>
+            </Menu.Item>
+          ))}
+        </Menu>
+        <Button positive fluid content={t('action.confirm')} onClick={handleConfirmClick} />
+      </Popup.Content>
+    </>
+  );
+});
+
+AddAllStep.propTypes = {
+  count: PropTypes.number.isRequired,
+  onConfirm: PropTypes.func.isRequired,
+  onBack: PropTypes.func,
+  onClose: PropTypes.func.isRequired,
+};
+
+AddAllStep.defaultProps = {
+  onBack: undefined,
+};
+
+export default AddAllStep;
