diff --git a/client/src/utils/move-current-user-first.js b/client/src/utils/move-current-user-first.js
new file mode 100644
index 0000000..ad96f7f
--- /dev/null
+++ b/client/src/utils/move-current-user-first.js
@@ -0,0 +1,24 @@
+/*!
+ * Copyright (c) 2024 PLANKA Software GmbH
+ * Licensed under the Fair Use License: https://github.com/plankanban/planka/blob/master/LICENSE.md
+ */
+
+// BSY Media: shared by every "list of users" in the app (Administration,
+// board Share modal, card member picker, card front avatars, board
+// filters, ...) so the logged-in user always sees themselves first, without
+// duplicating this logic per component. Works on any array - pass a
+// `getUserId` for arrays of objects (defaults to `.id`), or an identity
+// function for arrays of plain user ID strings.
+export default (items, currentUserId, getUserId = (item) => item.id) => {
+  const index = items.findIndex((item) => getUserId(item) === currentUserId);
+
+  if (index <= 0) {
+    return items;
+  }
+
+  const nextItems = items.slice();
+  const [currentUserItem] = nextItems.splice(index, 1);
+  nextItems.unshift(currentUserItem);
+
+  return nextItems;
+};
